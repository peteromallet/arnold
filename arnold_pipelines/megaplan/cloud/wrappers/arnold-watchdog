        plans_root.glob("*/state.json"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    if candidates:
        state_path = candidates[0]


def iso_to_dt(value):
    if not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed


recorded_at = None
if state_path is not None:
    try:
        payload = json.loads(state_path.read_text(encoding="utf-8"))
    except Exception:
        payload = {}
    failure = payload.get("latest_failure")
    failure = failure if isinstance(failure, dict) else {}
    recorded_at = iso_to_dt(failure.get("recorded_at"))
try:
    duration = parse_duration(after)
except (ValueError, TypeError):
    raise SystemExit(1)
if recorded_at is None:
    # No durable reference timestamp: fail-safe and fire.
    raise SystemExit(0)
elapsed = dt.datetime.now(dt.timezone.utc) - recorded_at
if elapsed >= duration:
    raise SystemExit(0)
raise SystemExit(1)
PY
}

# 0 when a babysitter is already live for the same occurrence digest, 1
# otherwise. Checks the launch receipt (supervisor pid) and the watchdog
# dispatch receipt (babysitter pid). A pid is live iff kill(pid, 0) succeeds.
babysitter_running_for_occurrence() {
  local session="$1"
  local digest="$2"
  PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
    "$session" "$digest" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" <<'PY'
import json
import os
import pathlib
import sys
from datetime import datetime, timedelta, timezone

session, digest, repair_data_raw = sys.argv[1:]
repair_data = pathlib.Path(repair_data_raw)


def pid_live(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _proc_root():
    return pathlib.Path(os.environ.get("CLOUD_WATCHDOG_BABYSITTER_PROC_ROOT", "/proc"))


def _progress_logs(payload, run_root):
    """Files that actually move while a babysitter is working.

    ``run.log`` is the managed-agent capture. It is silent during a model
    call: the omp launcher is non-TTY (PIPE), so it writes ``[tool]`` at
    tool start and ``[done]`` at tool end, and nothing while the LLM thinks.
    ``babysitter.stdout.log`` is a tee of that same stream (managed_agent
    tee_output=True); ``babysitter.stderr.log`` is the supervisor. Watching
    only ``run.log`` is what produced the I51 18-minute false-positive reap.
    """
    seen = []
    seen_ids = set()

    def _add(path):
        try:
            resolved = path.resolve()
        except OSError:
            return
        marker = str(resolved)
        if marker in seen_ids or not resolved.is_file():
            return
        seen_ids.add(marker)
        seen.append(resolved)

    if run_root and run_root.is_dir():
        _add(run_root / "babysitter.stdout.log")
        _add(run_root / "babysitter.stderr.log")
        for path in run_root.rglob("run.log"):
            _add(path)
    for key in ("stdout_log", "stderr_log"):
        raw = payload.get(key)
        if isinstance(raw, str) and raw:
            _add(pathlib.Path(raw))
    return seen


def _socket_inodes(pid, proc):
    fd_dir = proc / str(pid) / "fd"
    inodes = set()
    try:
        for entry in fd_dir.iterdir():
            try:
                target = os.readlink(entry)
            except OSError:
                continue
            if target.startswith("socket:[") and target.endswith("]"):
                inodes.add(target[8:-1])
    except OSError:
        return inodes
    return inodes


def _pid_has_established_tcp(pid, proc):
    inodes = _socket_inodes(pid, proc)
    if not inodes:
        return False
    tables = [
        proc / str(pid) / "net" / "tcp",
        proc / str(pid) / "net" / "tcp6",
        proc / "net" / "tcp",
        proc / "net" / "tcp6",
    ]
    seen = set()
    for table in tables:
        marker = str(table)
        if marker in seen or not table.is_file():
            continue
        seen.add(marker)
        try:
            lines = table.read_text(encoding="utf-8", errors="replace").splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            # st == 01 is ESTABLISHED; field 9 is inode.
            if len(parts) >= 10 and parts[3] == "01" and parts[9] in inodes:
                return True
    return False


def _pid_runnable(pid, proc):
    try:
        stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
        state = stat.rsplit(") ", 1)[1].split()[0]
    except (OSError, IndexError):
        return False
    return state in {"R", "D"}


def _descendant_pids(root_pids, proc):
    children = {}
    try:
        for entry in proc.iterdir():
            if not entry.name.isdigit():
                continue
            try:
                stat = (entry / "stat").read_text(encoding="utf-8")
                ppid = int(stat.rsplit(") ", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            children.setdefault(ppid, []).append(int(entry.name))
    except OSError:
        return []
    out = []
    stack = []
    for root in root_pids:
        stack.extend(children.get(int(root), []))
    seen = set()
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        out.append(pid)
        stack.extend(children.get(pid, []))
    return out


def _tree_has_live_work(root_pids):
    """True if the babysitter tree is mid-call; None if /proc is unreadable.

    A legitimate Flash babysitter spends most of its life in one of two
    silent-log states: (1) blocked on an LLM SSE socket, (2) waiting on a
    child (fan.py / pytest / grep) that is itself running or on a socket.
    ``run.log`` growth cannot see either. I18/I32/I34 hangs are the inverse:
    live pid, 0% CPU, 0 sockets, no children working.
    """
    proc = _proc_root()
    if not proc.is_dir():
        return None
    pids = []
    for raw in root_pids:
        if isinstance(raw, int) and raw > 0:
            pids.append(raw)
    if not pids:
        return False
    for pid in (*pids, *_descendant_pids(pids, proc)):
        if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
            return True
    return False


def _pid_comm(pid, proc):
    try:
        return (proc / str(pid) / "comm").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _pid_cmdline(pid, proc):
    try:
        raw = (proc / str(pid) / "cmdline").read_bytes().replace(b"\x00", b" ")
        return raw.decode("utf-8", "replace")
    except OSError:
        return ""


def _pid_age_seconds(pid, proc):
    """Seconds since pid start. None if /proc is unreadable."""
    try:
        stat = (proc / str(pid) / "stat").read_text(encoding="utf-8")
        startticks = int(stat.rsplit(") ", 1)[1].split()[19])
        hz = os.sysconf("SC_CLK_TCK") or 100
        uptime = float((proc / "uptime").read_text(encoding="utf-8").split()[0])
    except (OSError, IndexError, ValueError):
        return None
    return uptime - (startticks / float(hz))


def _is_codex_child(pid, proc):
    comm = _pid_comm(pid, proc)
    cmd = _pid_cmdline(pid, proc)
    return comm == "codex" or comm.startswith("codex") or "codex exec" in cmd


def _progress_has_tool_line(paths):
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if "[tool]" in text or "[done]" in text:
            return True
    return False


