adopt_unmarked_tmux_sessions() {
  local discover_bin="${DISCOVER_BIN:-$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/arnold-cloud-discover}"
  [[ -f "$discover_bin" ]] || return 0

  # Discovery is retained for operator diagnostics only.  A tmux session has
  # no marker-bound namespace/start identity, so it may not synthesize a
  # marker (which would in turn admit repair/relaunch/retirement control).
  while IFS=$'\t' read -r session workspace remote_spec run_kind plan_name relaunch_command; do
    [[ -n "${session:-}" ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$session" "$workspace" "$remote_spec" "${run_kind:-chain}" "${plan_name:-}"
  done < <(bash "$discover_bin" tmux-unmarked --marker-dir "$MARKER_DIR" --src-dir "$SRC_DIR")
}

