        observed = manifest_bytes_sha256(manifest_path)
    except Exception as exc:
        raise RuntimeError("session marker manifest is unreadable") from exc
    if observed != values["manifest_sha256"] or observed != values["manifest_identity"]:
        raise RuntimeError("session marker manifest identity mismatch")
    return str(manifest_path), observed


