import datetime as dt
import json
import pathlib
import sys

from arnold_pipelines.megaplan.resident.schedules import parse_duration

after, session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
workspace = pathlib.Path(workspace_raw)
plan_name = str(plan_name or "").strip()
state_path = None
