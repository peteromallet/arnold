# 0 when the after-duration (ISO-8601, e.g. PT1H) has elapsed since the
# unhealthy state began (latest_failure.recorded_at), or when no reference
# timestamp exists (fail-safe: fire). 1 when the chain must keep waiting.
babysitter_after_elapsed() {
  local after="$1"
  local session="$2"
  local workspace="$3"
