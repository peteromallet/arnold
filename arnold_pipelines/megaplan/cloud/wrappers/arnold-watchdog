def signal_hung_fixer_children(root_pids):
    """SIGTERM hung ``codex exec`` descendants. Does not touch the babysitter.

    I18 signature: process exists, not R/D, no ESTABLISHED TCP, older than
    the consult bound. A thinking consult has a socket and is left alone.
    """
    proc = _proc_root()
    if not proc.is_dir():
        return []
    bound = float(os.environ.get("CLOUD_WATCHDOG_HUNG_CHILD_MINUTES", "20")) * 60
    pids = [raw for raw in root_pids if isinstance(raw, int) and raw > 0]
    signaled = []
    for pid in _descendant_pids(pids, proc):
        if not _is_codex_child(pid, proc):
            continue
        if _pid_runnable(pid, proc) or _pid_has_established_tcp(pid, proc):
            continue
        age = _pid_age_seconds(pid, proc)
        if age is None or age < bound:
            continue
        if _canonical_shell_signal(pid, "arnold-watchdog-worker"):
            signaled.append(pid)
    return signaled


def babysitter_wedged(payload, run_root):
    """A live-pid fixer that has made NO progress is wedged.

    Contract (I51b): a busy unbounded babysitter is never reaped. Wedge
    means: past newborn/first-call grace, no fresh progress file, and the
    process tree shows no live work. A hung ``codex`` child is not a reason
    to reap the parent — signal_hung_fixer_children handles that. If /proc
    cannot be inspected, fail open.
    """
    launch_stall_minutes = float(
        os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LAUNCH_STALL_MINUTES", "5")
    )
    log_stall_minutes = float(
        os.environ.get("CLOUD_WATCHDOG_BABYSITTER_LOG_STALL_MINUTES", "10")
    )
    # stdout.log is created at Popen, so log-stall starts at launch and
    # expires at 10 min while the first DeepSeek call (timeout 600s) may
    # still have no [tool] line and no ESTABLISHED socket. 20 min covers
    # API timeout + bootstrap + one scan. Applies ONLY when no [tool]/[done]
    # has ever been written — not a general wall.
    first_call_grace_minutes = float(
        os.environ.get("CLOUD_WATCHDOG_BABYSITTER_FIRST_CALL_GRACE_MINUTES", "20")
    )
    try:
        launched_raw = payload.get("launched_at") or payload.get("dispatched_at")
        if not launched_raw:
            return False
        launched = datetime.fromisoformat(str(launched_raw).replace("Z", "+00:00"))
        age = datetime.now(timezone.utc) - launched
        if age < timedelta(minutes=launch_stall_minutes):
            return False
    except Exception:
        return False
    paths = list(_progress_logs(payload, run_root))
    if not _progress_has_tool_line(paths):
        if age < timedelta(minutes=first_call_grace_minutes):
            return False
    newest = None
    for path in paths:
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if newest is None or mtime > newest:
            newest = mtime
    if newest is not None:
        if datetime.now(timezone.utc).timestamp() - newest < log_stall_minutes * 60:
            return False
    live_work = _tree_has_live_work(
        (payload.get("babysitter_pid"), payload.get("supervisor_pid"))
    )
    if live_work is True:
        return False
    if live_work is None:
        return False
    return True


