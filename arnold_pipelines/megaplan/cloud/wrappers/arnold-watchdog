# Per-session runtime-binding preflight.  Identity is the marker session
# (canonical producer: cli.py _chain_runtime_manifest_path -> {manifest_dir}/{session}.json),
# NOT this watchdog process's ARNOLD_RUNTIME_MANIFEST / MANIFEST_RUNTIME_ROOT /
# LIVE_IMPORT_ROOT.  A multi-engine box (per-epic worktrees) has one supervisor
# observing many sessions; comparing a session's recorded root to the
# supervisor's own root is env-scoped, not identity-scoped (T-0022 1:1 leak).
# The session's own manifest epic.runtime_root is the only truth.
chain_engine_root_preflight() {
  local workspace="$1"
  local remote_spec="$2"
  local session="$3"
  local plan_name="${4:-}"
  local manifest_dir="${ARNOLD_RUNTIME_MANIFEST_DIR:-/workspace/.megaplan}"
  [[ -n "$workspace" && -n "$session" ]] || {
    echo "chain_runtime_binding_drift: relaunch preflight missing workspace or session identity" >&2
    return 24
  }
  if [[ -z "$remote_spec" && -n "$plan_name" ]]; then
    # A plan relaunch carries no spec: resolve the one canonical chain whose
    # persisted execution binding owns the plan.  A plan with no bound chain
    # (standalone) still MUST prove recorded == session manifest below.
    remote_spec="$(python3 - "$workspace" "$plan_name" <<'PY' 2>/dev/null || true
import pathlib
import sys

try:
    from arnold_pipelines.megaplan.chain.execution_binding import find_bound_chain_spec
except Exception:
    raise SystemExit(1)
spec = find_bound_chain_spec(pathlib.Path(sys.argv[1]), plan_name=sys.argv[2])
if spec:
    print(spec)
PY
)"
  fi
  python3 - "$workspace" "$remote_spec" "$session" "$manifest_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

workspace, remote_spec, session, manifest_dir = sys.argv[1:5]
workspace_path = pathlib.Path(workspace)


def drift(reason: str) -> None:
    print(f"chain_runtime_binding_drift: {reason}", file=sys.stderr)
    raise SystemExit(24)


session_manifest_path = pathlib.Path(manifest_dir) / f"{session}.json"
try:
    payload = json.loads(session_manifest_path.read_text(encoding="utf-8"))
except Exception:
    drift(f"session runtime manifest missing: {session_manifest_path}")
if not isinstance(payload, dict):
    drift(f"session runtime manifest {session_manifest_path} is not an object")
epic = payload.get("epic")
if not isinstance(epic, dict):
    drift(f"session runtime manifest {session_manifest_path} lacks epic")
raw_root = epic.get("runtime_root")
if not isinstance(raw_root, str) or not raw_root.strip():
    drift(f"session runtime manifest {session_manifest_path} lacks epic.runtime_root")
manifest = pathlib.Path(raw_root).expanduser().resolve()


def require_engine(root: pathlib.Path, label: str) -> None:
    if not root.is_dir() or not (root / ".git").exists():
        drift(f"{label} {root} is missing or dangling")
    if not (root / "arnold_pipelines").is_dir():
        drift(f"{label} {root} has no arnold_pipelines package")


if not remote_spec:
    # A STANDALONE plan carries no recorded engine root; the session manifest
    # epic.runtime_root IS the binding.  Prove it is a real engine checkout.
    require_engine(manifest, "session manifest runtime root")
    print(manifest)
    raise SystemExit(0)

spec_path = pathlib.Path(remote_spec)
if not spec_path.is_absolute():
    spec_path = workspace_path / spec_path
try:
    spec_path = spec_path.resolve()
except OSError:
    pass
digest = hashlib.sha1(str(spec_path).encode("utf-8")).hexdigest()[:12]
state_path = workspace_path / ".megaplan" / "plans" / ".chains" / f"chain-{digest}.json"

try:
    payload = json.loads(state_path.read_text(encoding="utf-8"))
except Exception:
    drift(f"chain state {state_path} missing or unreadable")
if not isinstance(payload, dict):
    drift(f"chain state {state_path} is not an object")
metadata = payload.get("metadata")
if not isinstance(metadata, dict):
    drift(f"chain state {state_path} lacks metadata")
execution_environment = metadata.get("execution_environment")
if not isinstance(execution_environment, dict):
    drift(f"chain state {state_path} lacks metadata.execution_environment")
recorded_root = execution_environment.get("engine_root")
if not isinstance(recorded_root, str) or not recorded_root.strip():
    drift(f"chain state {state_path} lacks metadata.execution_environment.engine_root")
recorded = pathlib.Path(recorded_root).expanduser().resolve()
require_engine(recorded, "recorded engine root")
if recorded != manifest:
    drift(f"engine root mismatch: recorded={recorded} manifest={manifest}")
print(recorded)
PY
}

