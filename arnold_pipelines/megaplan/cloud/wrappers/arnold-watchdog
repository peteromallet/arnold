default_chain_relaunch_command() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local log_relative repair_queue_root repair_marker_dir accepted_root
  if [[ "$session" == "megaplan-chain" ]]; then
    log_relative=".megaplan/cloud-chain.log"
  else
    log_relative=".megaplan/cloud-chain-${session}.log"
  fi
  # The runtime IS the code (P4): the launch bound this session to the
  # per-epic manifest runtime; this safety fallback re-runs the same chain
  # start from the accepted (manifest) runtime root (fixed /workspace/arnold
  # for permit-admitted manifest-less sessions).  T-0022: re-read the
  # persisted engine root from the chain state and fail closed on drift
  # BEFORE building PYTHONPATH; only the accepted root goes on PYTHONPATH.
  # No editable-install refresh, no source checkout mutation, no
  # env-selector re-resolution.
  accepted_root="$(chain_engine_root_preflight "$workspace" "$remote_spec" "$session")" || return $?
  [[ -n "$accepted_root" ]] || return 24
  repair_marker_dir="${MARKER_DIR:-/workspace/.megaplan/cloud-sessions}"
  repair_queue_root="${ARNOLD_REPAIR_QUEUE_ROOT:-${repair_marker_dir%/*}/repair-queue}"
  printf 'unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START
