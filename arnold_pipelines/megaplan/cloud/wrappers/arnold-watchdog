print(str(selected))
PY
}

reconcile_awaiting_pr_merge() {
  local session="$1" workspace="$2" remote_spec="${3:-}"
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$MARKER_DIR" <<'PY'
import json
import pathlib
import subprocess
import sys
import time

session, workspace_raw, remote_spec_raw, marker_dir = sys.argv[1:]
workspace = pathlib.Path(workspace_raw)
remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
if remote_spec is not None and not remote_spec.is_absolute():
    remote_spec = workspace / remote_spec
plans_dir = workspace / ".megaplan" / "plans"


def emit(status: str, message: str = "") -> None:
    print(f"{status}\t{message}")


def load_json(path: pathlib.Path) -> dict:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


def advancement_policy() -> tuple[bool, str]:
    if remote_spec is None:
        return False, "chain spec is missing"
    try:
        from arnold_pipelines.megaplan.chain.advancement import policy_for_spec_path

        policy = policy_for_spec_path(remote_spec)
    except Exception as exc:
        return False, f"chain advancement policy unreadable: {exc}"
    return (
        policy.automatic_pr_progression,
        f"merge_policy={policy.merge_policy} "
        f"clean_milestone_pr={policy.clean_milestone_pr} source={policy.source}",
    )


def chain_state_paths() -> list[pathlib.Path]:
    paths = {
        *plans_dir.glob(".chains/*.json"),
        *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
        *(workspace / ".megaplan").glob("**/chain_state.json"),
    }
    if remote_spec is not None:
        sibling = remote_spec.with_name("chain_state.json")
        if sibling.exists():
            paths.add(sibling)
    return sorted(paths, key=lambda path: path.stat().st_mtime, reverse=True)


def gh_pr_state(pr_number: int) -> tuple[str, str, str]:
    proc = subprocess.run(
        ["gh", "pr", "view", str(pr_number), "--json", "state,mergeCommit,headRefOid"],
        cwd=workspace,
        check=False,
        capture_output=True,
        text=True,
        timeout=120,
    )
    if proc.returncode != 0:
        return "", "", ""
    try:
        payload = json.loads(proc.stdout or "{}")
    except Exception:
        return "", "", ""
    state = payload.get("state")
    merge_commit = payload.get("mergeCommit")
    oid = ""
    if isinstance(merge_commit, dict):
        raw_oid = merge_commit.get("oid")
        oid = raw_oid if isinstance(raw_oid, str) else ""
    head_oid = ""
    raw_head = payload.get("headRefOid")
    if isinstance(raw_head, str) and raw_head:
        head_oid = raw_head
    return (state.lower() if isinstance(state, str) else "", oid, head_oid)


def enqueue_wait_evidence(path: pathlib.Path, pr_number: int, pr_state: str) -> str:
    # Awaiting a PR merge is expected wait state, not a repair occurrence.
    # ``watchdog_pr_merge_reconciliation`` and ``pr_boundary_evidence`` are
    # persisted on the chain state immediately above this call.  Do not mint a
    # repair identity from PR labels or enqueue an unclaimable repair request.
    del path, pr_number, pr_state
    return "read_only"


automatic_progression, policy_reason = advancement_policy()
if not automatic_progression:
    emit("review_policy", policy_reason)
    raise SystemExit(0)

for path in chain_state_paths():
    payload = load_json(path)
    if payload.get("last_state") != "awaiting_pr_merge":
        continue
    pr_number = payload.get("pr_number")
    try:
        pr_number_int = int(pr_number)
    except Exception:
        emit("missing_pr", f"{path} has no PR number")
        raise SystemExit(0)
    pr_state, merge_oid, pr_head_sha = gh_pr_state(pr_number_int)
    payload["pr_state"] = pr_state or payload.get("pr_state")
    payload.setdefault("metadata", {})
    evidence_ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if isinstance(payload["metadata"], dict):
        payload["metadata"]["watchdog_pr_merge_reconciliation"] = {
            "checked_at": evidence_ts,
            "pr_number": pr_number_int,
            "pr_state": pr_state or "unknown",
            "merge_commit": merge_oid,
        }
        # PR boundary-contract conformant evidence — queued/waiting/merged
        # reconciliation conforms to pr_ready / pr_merged boundary contracts
        # (pr.ready.1 / pr.merged.1) while preserving the existing
        # watchdog_pr_merge_reconciliation metadata.
        boundary_contract_id = "pr.merged.1" if pr_state == "merged" else "pr.ready.1"
        boundary_evidence = {
            "contract_id": boundary_contract_id,
            "boundary_id": "pr_merged" if pr_state == "merged" else "pr_ready",
            "workflow_id": "megaplan-review",
            "pr_number": pr_number_int,
            "pr_state": pr_state or "unknown",
            "pr_head_sha": pr_head_sha or None,
            "evidence_timestamp": evidence_ts,
            "expected_state_delta": {
                "pr_stage": "merged" if pr_state == "merged" else pr_state or "ready",
            },
        }
        if pr_state == "merged":
            boundary_evidence["merge_commit_sha"] = merge_oid or None
        payload["metadata"]["pr_boundary_evidence"] = boundary_evidence
    try:
        path.write_text(json.dumps(payload, sort_keys=True, indent=2) + "\n", encoding="utf-8")
    except Exception:
        pass
    if pr_state == "merged":
        subprocess.run(
            ["git", "fetch", "origin", "--prune"],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=180,
        )
        if merge_oid:
            subprocess.run(
                ["git", "cat-file", "-e", f"{merge_oid}^{{commit}}"],
                cwd=workspace,
                check=False,
                capture_output=True,
                text=True,
                timeout=30,
            )
        emit("merged", f"PR #{pr_number_int} merged; fetched origin for chain relaunch")
        raise SystemExit(0)
    evidence_status = enqueue_wait_evidence(path, pr_number_int, pr_state)
    emit("waiting", f"PR #{pr_number_int} state={pr_state or 'unknown'} evidence={evidence_status}")
    raise SystemExit(0)

emit("none", "no awaiting auto-policy PR merge state")
PY
}

plan_phase_health_status() {
  local workspace="$1"
  local run_kind="${2:-chain}"
  local plan_name="${3:-}"
  python3 - "$workspace" "$run_kind" "$plan_name" <<'PY'
import datetime as dt
import json
import pathlib
import sys

workspace = pathlib.Path(sys.argv[1])
run_kind = sys.argv[2]
plan_name = sys.argv[3]
plans_dir = workspace / ".megaplan" / "plans"
if run_kind == "plan" and plan_name:
    state_files = [plans_dir / plan_name / "state.json"]
else:
    state_files = sorted(
        plans_dir.glob("*/state.json"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
if not state_files:
    print("ok")
    raise SystemExit(0)

state_path = state_files[0]
if run_kind == "plan" and plan_name and not state_path.exists():
    print(f"plan_state_missing:{plan_name}")
    raise SystemExit(0)
try:
    state = json.loads(state_path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"state_unreadable:{state_path.parent.name}:{exc}")
    raise SystemExit(0)

def _parse_timestamp(value: str) -> dt.datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


now = dt.datetime.now(dt.timezone.utc)
active = state.get("active_step") or {}
active_phase = str(active.get("phase") or "").strip()
active_last_activity = (
    _parse_timestamp(active.get("last_activity_at"))
    or _parse_timestamp(active.get("started_at"))
)
recent_active_state = False
events_path = state_path.parent / "events.ndjson"
if active_phase:
    if active_last_activity is not None and (now - active_last_activity) <= dt.timedelta(minutes=5):
        recent_active_state = True
if not recent_active_state and events_path.exists():
    try:
        events_mtime = dt.datetime.fromtimestamp(events_path.stat().st_mtime, tz=dt.timezone.utc)
    except OSError:
        events_mtime = None
    if events_mtime is not None and (now - events_mtime) <= dt.timedelta(minutes=5):
        recent_active_state = True

log_candidates = []
for pattern in ("cloud-chain*.log", "cloud-logs/*.log"):
    log_candidates.extend((workspace / ".megaplan").glob(pattern))
log_candidates = sorted(
    [path for path in log_candidates if path.is_file()],
    key=lambda path: path.stat().st_mtime,
    reverse=True,
)
for log_path in log_candidates[:3]:
    try:
        recent = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-240:]
    except Exception:
        continue
    last_sandbox_refusal = -1
    for idx, line in enumerate(recent):
        if "sandbox refused terminal" not in line:
            continue
        if (
            "outside the sandbox root/project directory" in line
            or "outside the worktree" in line
        ):
            last_sandbox_refusal = idx
    if last_sandbox_refusal >= 0:
        later_progress = any(
            marker in line
            for line in recent[last_sandbox_refusal + 1 :]
            for marker in ("[tool]", "[auto ", "[chain]")
        )
        if later_progress or recent_active_state:
            continue
        print(
            "workspace_drift:"
            f"{state_path.parent.name}:"
            f"log={log_path.name}:"
            "sandbox_refused_outside_project_root"
        )
        raise SystemExit(0)

latest_failure = state.get("latest_failure") or {}
failure_kind = latest_failure.get("kind")
if failure_kind in {"execution_blocked", "blocked_recovery_not_resolved"}:
    phase = latest_failure.get("phase") or "execute"
    recorded_at = latest_failure.get("recorded_at") or ""
    active = state.get("active_step") or {}
    active_phase = active.get("phase") or ""
    active_pid = active.get("worker_pid") or ""
    active_started = active.get("started_at") or ""
    current_state = state.get("current_state") or ""
    message = latest_failure.get("message") or ""
    print(
        "phase_failure:"
        f"{state_path.parent.name}:"
        f"{phase}:"
        "consecutive=1:"
        f"recorded={recorded_at or 'unknown'}:"
        f"state={current_state or 'unknown'}:"
        f"active={active_phase or 'none'}:"
        f"started={active_started or 'unknown'}:"
        f"pid={active_pid or 'none'}:"
        f"{failure_kind}:{message[:140]}"
    )
    raise SystemExit(0)
if failure_kind != "phase_failed":
    print("ok")
    raise SystemExit(0)

phase = latest_failure.get("phase") or "unknown"
recorded_at = latest_failure.get("recorded_at") or ""
history = state.get("history") or []
consecutive = 0
for item in reversed(history):
    if item.get("step") == phase and item.get("result") == "error":
        consecutive += 1
        continue
    if item.get("step") == phase and item.get("result") == "success":
        break
    if consecutive:
        break

active = state.get("active_step") or {}
active_phase = active.get("phase") or ""
active_pid = active.get("worker_pid") or ""
active_started = active.get("started_at") or ""
current_state = state.get("current_state") or ""
message = latest_failure.get("message") or ""

success_after_failure = False
for item in history:
    if item.get("step") != phase or item.get("result") != "success":
        continue
    timestamp = item.get("timestamp") or item.get("completed_at") or ""
    if recorded_at and timestamp and timestamp > recorded_at:
        success_after_failure = True
        break

if success_after_failure:
    print("ok")
    raise SystemExit(0)

print(
    "phase_failure:"
    f"{state_path.parent.name}:"
    f"{phase}:"
    f"consecutive={consecutive}:"
    f"recorded={recorded_at or 'unknown'}:"
    f"state={current_state or 'unknown'}:"
    f"active={active_phase or 'none'}:"
    f"started={active_started or 'unknown'}:"
    f"pid={active_pid or 'none'}:"
    f"{message[:160]}"
)
PY
}

plan_progress_stall_status() {
  local workspace="$1"
  local run_kind="${2:-chain}"
  local plan_name="${3:-}"
  python3 - "$workspace" "$MARKER_DIR" "$run_kind" "$plan_name" <<'PY'
import datetime as dt
import json
import os
import pathlib
import sys

workspace = pathlib.Path(sys.argv[1])
marker_dir = pathlib.Path(sys.argv[2])
run_kind = sys.argv[3]
plan_name_arg = sys.argv[4]

# Env-tunable thresholds (defaults from the cloud-watchdog progress-stall contract).
ITER_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ITERATIONS", "8"))
ATTEMPT_MAX = int(os.environ.get("CLOUD_WATCHDOG_STALL_ATTEMPTS", "10"))
PLAN_GROWTH_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_PLANGROWTH_MINS", "15"))
EVENTS_MINS = int(os.environ.get("CLOUD_WATCHDOG_STALL_EVENTS_MINS", "10"))

plans_dir = workspace / ".megaplan" / "plans"
if run_kind == "plan" and plan_name_arg:
    state_files = [plans_dir / plan_name_arg / "state.json"]
else:
    state_files = sorted(
        plans_dir.glob("*/state.json"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
if not state_files:
    print("ok")
    raise SystemExit(0)

state_path = state_files[0]
plan_dir = state_path.parent
plan_name = plan_dir.name
if run_kind == "plan" and plan_name_arg and not state_path.exists():
    print(f"plan_state_missing:{plan_name_arg}")
    raise SystemExit(0)
try:
    state = json.loads(state_path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"stall_unreadable:{plan_name}:{exc}")
    raise SystemExit(0)

now = dt.datetime.now(dt.timezone.utc)

def _age_minutes(mtime_ts):
    if not mtime_ts:
        return None
    try:
        when = dt.datetime.fromtimestamp(mtime_ts, tz=dt.timezone.utc)
    except (OSError, ValueError, OverflowError):
        return None
    return max(0, int((now - when).total_seconds() // 60))

iteration = int(state.get("iteration") or 0)
# Top-level iteration can lag the internal milestone counter; the recovery
# layer records the live milestone iteration in latest_failure.metadata.iteration.
latest_failure = state.get("latest_failure") or {}
failure_meta = latest_failure.get("metadata") or {}
milestone_iteration = iteration
meta_iter = failure_meta.get("iteration")
if isinstance(meta_iter, (int, float)) and meta_iter > milestone_iteration:
    milestone_iteration = int(meta_iter)
stall_count = int(failure_meta.get("stall_count") or 0)

active_step = state.get("active_step") or {}
attempt = int(active_step.get("attempt") or 0)

plan_v_files = sorted(plan_dir.glob("plan_v*.md"))
plan_v_count = len(plan_v_files)
events_path = plan_dir / "events.ndjson"
events_mtime = events_path.stat().st_mtime if events_path.exists() else 0

# Tick-over-tick snapshot for "no growth while iteration advances" detection.
snapshot_dir = marker_dir
snapshot_dir.mkdir(parents=True, exist_ok=True)
snapshot_path = snapshot_dir / f"{plan_name}.progress.json"
prev = {}
if snapshot_path.exists():
    try:
        prev = json.loads(snapshot_path.read_text(encoding="utf-8"))
    except Exception:
        prev = {}

unchanged_ticks = 0
prev_iter = int(prev.get("iteration") or -1)
prev_plan_count = int(prev.get("plan_v_count") or -1)
if prev:
    if plan_v_count == prev_plan_count and milestone_iteration >= prev_iter:
        unchanged_ticks = int(prev.get("unchanged_ticks") or 0) + 1
    elif plan_v_count != prev_plan_count:
        unchanged_ticks = 0
    else:
        unchanged_ticks = int(prev.get("unchanged_ticks") or 0)

snapshot = {
    "iteration": milestone_iteration,
    "plan_v_count": plan_v_count,
    "events_mtime": events_mtime,
    "unchanged_ticks": unchanged_ticks,
    "ts": now.isoformat(),
}
try:
    snapshot_path.write_text(json.dumps(snapshot, sort_keys=True) + "\n", encoding="utf-8")
except Exception:
    pass

newest_plan_age = None
if plan_v_files:
    newest_mtime = max(p.stat().st_mtime for p in plan_v_files)
    newest_plan_age = _age_minutes(newest_mtime)
events_age = _age_minutes(events_mtime)

signals = []
if milestone_iteration >= ITER_MAX:
    signals.append(f"iteration={milestone_iteration}>={ITER_MAX}")
if attempt and attempt >= ATTEMPT_MAX:
    signals.append(f"active_step.attempt={attempt}>={ATTEMPT_MAX}")
if stall_count >= 3:
    signals.append(f"stall_count={stall_count}")
if (
    unchanged_ticks >= 2
    and milestone_iteration > prev_iter
    and plan_v_count == prev_plan_count
):
    signals.append(f"plan_v_count={plan_v_count} unchanged-{unchanged_ticks}-ticks")
if newest_plan_age is not None and newest_plan_age >= PLAN_GROWTH_MINS and milestone_iteration >= max(2, ITER_MAX - 2):
    signals.append(f"plan_v_unchanged_{newest_plan_age}m")
if events_age is not None and events_age >= EVENTS_MINS and state.get("current_state") not in {None, "completed", "abandoned", "awaiting_review"}:
    signals.append(f"events_stale={events_age}m")

if not signals:
    print("ok")
    raise SystemExit(0)

detail = " ".join(signals)
print(
    f"progress_stall:{plan_name}:"
    f"iteration={iteration}:"
    f"attempt={attempt}:"
    f"plan_v_count={plan_v_count}:"
    f"{detail}"
)
PY
}

session_terminal_status() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local current_target_observation="${5:-}"
  local marker_dir="${6:-$MARKER_DIR}"
  [[ "$run_kind" == "chain" || "$run_kind" == "epic_chain" ]] || return 0
  python3 - "$session" "$workspace" "$remote_spec" "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$current_target_observation" "$marker_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

session, workspace_raw, remote_spec_raw, repair_data_raw, current_target_raw, marker_dir_raw = sys.argv[1:]
workspace = pathlib.Path(workspace_raw)
remote_spec = pathlib.Path(remote_spec_raw)
if not remote_spec.is_absolute():
    remote_spec = workspace / remote_spec
repair_data_dir = pathlib.Path(repair_data_raw)
marker_dir = pathlib.Path(marker_dir_raw)


def spec_milestone_count() -> int | None:
    try:
        raw = remote_spec.read_text(encoding="utf-8")
    except Exception:
        return None
    try:
        import yaml  # type: ignore

        data = yaml.safe_load(raw)
        milestones = data.get("milestones") if isinstance(data, dict) else None
        if isinstance(milestones, list):
            return len(milestones)
    except Exception:
        pass
    count = 0
    in_milestones = False
    for line in raw.splitlines():
        if line.startswith("milestones:"):
            in_milestones = True
            continue
        if in_milestones and line and not line.startswith((" ", "-")):
            break
        if in_milestones and line.lstrip().startswith("-"):
            count += 1
    return count if in_milestones else None


SPEC_MILESTONE_COUNT = spec_milestone_count()


def is_complete_state(payload: object) -> bool:
    if not isinstance(payload, dict):
        return False
    last_state = str(payload.get("last_state") or payload.get("current_state") or "").strip()
    current_plan = str(payload.get("current_plan_name") or "").strip()
    if last_state not in {"done", "complete", "completed"}:
        return False
    milestones = payload.get("milestones")
    completed = payload.get("completed")
    completed_list = completed if isinstance(completed, list) else []
    if isinstance(milestones, list) and milestones:
        if len(completed_list) < len(milestones):
            return False
    elif SPEC_MILESTONE_COUNT is not None and SPEC_MILESTONE_COUNT > 0:
        try:
            current_index = int(payload.get("current_milestone_index") or 0)
        except Exception:
            current_index = 0
        if len(completed_list) < SPEC_MILESTONE_COUNT and current_index < SPEC_MILESTONE_COUNT:
            return False
    if completed_list:
        incomplete = [
            item for item in completed_list
            if isinstance(item, dict) and str(item.get("status") or "").strip() not in {"done", "complete", "completed"}
            and "label" not in item
        ]
        if incomplete:
            return False
    events = payload.get("events")
    event_items = events if isinstance(events, list) else []
    event_text = " ".join(
        str(item.get("msg") or item.get("message") or item)
        for item in event_items
    )
    explicit_chain_complete = payload.get("chain_complete") is True
    explicit_completion_event = "all milestones complete" in event_text.lower()
    if (
        SPEC_MILESTONE_COUNT is None
        and not explicit_chain_complete
        and not explicit_completion_event
    ):
        return False
    if current_plan and not explicit_completion_event:
        return False
    return True


def iter_chain_states() -> list[pathlib.Path]:
    paths: list[pathlib.Path] = []
    chain_dirs: list[pathlib.Path] = []
    for base in (workspace, remote_spec.parent):
        chain_dir = base / ".megaplan" / "plans" / ".chains"
        if chain_dir not in chain_dirs:
            chain_dirs.append(chain_dir)
    for chain_dir in chain_dirs:
        if not chain_dir.exists():
            continue
        digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
        expected_paths = [
            chain_dir / f"{remote_spec.stem}-{digest}.json",
            chain_dir / f"chain-{digest}.json",
        ]
        paths.extend(path for path in expected_paths if path.exists())
        if paths:
            return paths
        paths.extend(
            [
                path
                for path in expected_paths
                if path not in paths
            ]
        )
        paths.extend(sorted(chain_dir.glob("*.json")))
    return paths


def current_target_marks_terminal_stale_chain() -> bool:
    if not current_target_raw:
        return False
    try:
        payload = json.loads(current_target_raw)
    except Exception:
        return False
    if not isinstance(payload, dict):
        return False
    plan_state = payload.get("plan_state")
    if not isinstance(plan_state, dict):
        return False
    plan_current_state = str(plan_state.get("current_state") or "").strip().lower()
    if plan_current_state not in {"done", "complete", "completed"}:
        return False
    stale_evidence = payload.get("stale_evidence")
    if not isinstance(stale_evidence, list):
        return False
    return any(
        isinstance(item, dict)
        and str(item.get("kind") or "").strip() == "stale_chain_state_after_terminal_plan"
        for item in stale_evidence
    )

def manifest_marks_chain_complete() -> bool:
    manifest_path = remote_spec.parent / "completion-manifest.json"
    try:
        payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception:
        return False
    if not isinstance(payload, dict):
        return False
    if str(payload.get("schema") or "").strip() != "arnold.megaplan.chain_completion_manifest.v1":
        return False
    milestones = payload.get("milestones")
    if not isinstance(milestones, list) or not milestones:
        return False
    terminal = {"done", "complete", "completed"}
    statuses = [
        str(item.get("status") or "").strip().lower()
        for item in milestones
        if isinstance(item, dict)
    ]
    return len(statuses) == len(milestones) and all(status in terminal for status in statuses)

def chain_health_blocks_terminal_shortcut() -> bool:
    path = marker_dir / f"{session}.chain-health.progress.json"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return False
    if not isinstance(payload, dict):
        return False
    snapshot = payload.get("snapshot")
    if not isinstance(snapshot, dict):
        snapshot = {}
    chain_complete = payload.get("chain_complete")
    if chain_complete is None:
        chain_complete = snapshot.get("chain_complete")
    if chain_complete is not False:
        return False
    try:
        completed_count = int(payload.get("completed_count") or snapshot.get("completed_count") or 0)
    except Exception:
        completed_count = 0
    try:
        milestone_count = int(payload.get("milestone_count") or snapshot.get("milestone_count") or 0)
    except Exception:
        milestone_count = 0
    pr_state = str(payload.get("pr_state") or snapshot.get("pr_state") or "").strip().lower()
    if milestone_count and completed_count < milestone_count:
        return True
    if pr_state and pr_state not in {"merged", "closed"}:
        return True
    return True


def current_chain_state_blocks_terminal_shortcut() -> bool:
    try:
        digest = hashlib.sha1(str(remote_spec.resolve()).encode("utf-8")).hexdigest()[:12]
    except Exception:
        digest = ""
    chain_dirs = [workspace / ".megaplan" / "plans" / ".chains"]
    if remote_spec.parent != workspace:
        chain_dirs.append(remote_spec.parent / ".megaplan" / "plans" / ".chains")
    candidate_names = ["chain.json"]
    if digest:
        candidate_names.extend([f"{remote_spec.stem}-{digest}.json", f"chain-{digest}.json"])
    for chain_dir in chain_dirs:
        for name in candidate_names:
            path = chain_dir / name
            if not path.exists():
                continue
            try:
                payload = json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                continue
            if isinstance(payload, dict) and not is_complete_state(payload):
                return True
    return False


if (
    current_target_marks_terminal_stale_chain()
    and not chain_health_blocks_terminal_shortcut()
    and not current_chain_state_blocks_terminal_shortcut()
):
    print("complete\tterminal plan state supersedes stale chain state")
    raise SystemExit(0)

if manifest_marks_chain_complete():
    print("complete\tcompletion manifest marks chain complete")
    raise SystemExit(0)


for path in iter_chain_states():
    if not path.exists():
        continue
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    if is_complete_state(payload):
        print("complete\tchain complete")
        raise SystemExit(0)

data_path = repair_data_dir / f"{session}.repair-data.json"
if data_path.exists():
    try:
        payload = json.loads(data_path.read_text(encoding="utf-8"))
    except Exception:
        payload = {}
    attempts = payload.get("attempts") if isinstance(payload, dict) else []
    if isinstance(attempts, list):
        for attempt in reversed(attempts):
            if not isinstance(attempt, dict):
                continue
            if str(attempt.get("failure_classification") or "") != "chain_completed":
                continue
            summary = attempt.get("chain_state_summary")
            if is_complete_state(summary):
                print("complete\tchain complete")
                raise SystemExit(0)
            context = attempt.get("failure_context")
            if isinstance(context, dict) and is_complete_state(context.get("chain_state_summary")):
                print("complete\tchain complete")
                raise SystemExit(0)
PY
}

repair_goal_watchdog_status() {
  local session="$1"
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" "$MEGAPLAN_SUPERVISOR_PYTHON" -P - "$MARKER_DIR" "$session" <<'PY' 2>>"${LOG:-/dev/null}"
import json
import os
import pathlib
import sys

from arnold_pipelines.megaplan.cloud.repair_goal import evaluate_repair_goal

marker_dir = pathlib.Path(sys.argv[1])
session = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in sys.argv[2]) or "unknown"
goal_dir = marker_dir / "repair-goals" / session
goals = sorted(goal_dir.glob("goal-*.json"), key=lambda path: path.stat().st_mtime, reverse=True)
for path in goals:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    if payload.get("status") != "active":
        continue
    result = evaluate_repair_goal(path, action="watchdog_authority_check")
    status = str(result.get("status") or "active")
    evaluation = result.get("evaluation") or {}
    reason = str(evaluation.get("reason") or "")
    control_action = str(evaluation.get("control_action") or "")
    observation = result.get("observation") or {}
    from arnold_pipelines.megaplan.cloud.current_target_liveness import (
        control_liveness_from_current_target,
    )
    target_liveness = control_liveness_from_current_target(
        {"current_target_liveness": observation.get("current_target_liveness")}
        if isinstance(observation, dict)
        else None,
        action="control",
    )
    target_worker_live = bool(
        target_liveness.get("state") == "live"
        and target_liveness.get("action_permitted") is True
    )
    if status != "active":
        print(
            f"{status}\t{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
            f"{'true' if target_worker_live else 'false'}"
        )
        raise SystemExit(0)
    refreshed = json.loads(path.read_text(encoding="utf-8"))
    owner_live = False
    for owner in reversed(refreshed.get("owners") or []):
        if not isinstance(owner, dict) or not owner.get("manifest_path"):
            continue
        try:
            manifest = json.loads(pathlib.Path(owner["manifest_path"]).read_text(encoding="utf-8"))
            pid = int(manifest.get("pid") or 0)
            if manifest.get("status") in {"reserved", "launching", "running", "adopting"} and pid > 0:
                os.kill(pid, 0)
                owner_live = True
                break
        except Exception:
            continue
    print(
        f"{'active_owner' if owner_live else 'active_unowned'}\t"
        f"{result.get('goal_id') or ''}\t{reason}\t{control_action}\t"
        f"{'true' if target_worker_live else 'false'}"
    )
    raise SystemExit(0)
print("none\t\t\t\tfalse")
PY
}

current_target_has_live_worker() {
  local observation="${1:-}"
  [[ -n "$observation" ]] || return 1
