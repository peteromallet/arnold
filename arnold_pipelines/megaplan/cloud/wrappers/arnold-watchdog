    if candidates:
        state_path = candidates[0]
else:
    chain_path = None
    if remote_spec_raw:
        spec_path = Path(remote_spec_raw)
        if not spec_path.is_absolute():
            spec_path = workspace / spec_path
        try:
            spec_resolved = spec_path.resolve()
        except Exception:
            spec_resolved = spec_path
        chain_digest = _hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
        for candidate in (
            workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
            workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
            spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
        ):
            if candidate.is_file():
                chain_path = candidate
                break
    if chain_path is not None:
        chain_state = _load_json(chain_path)
        chain_plan = str(chain_state.get("current_plan_name") or "").strip()
        if chain_plan:
            candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
            if candidate.is_file():
                state_path = candidate
    if state_path is None:
        plans_root = workspace / ".megaplan" / "plans"
        candidates = sorted(
            plans_root.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
        if candidates:
            state_path = candidates[0]

plan_state = _load_json(state_path)
resolved_plan_name = str(plan_state.get("name") or plan_name or "").strip()
if not resolved_plan_name and state_path is not None:
    resolved_plan_name = state_path.parent.name
latest_failure = plan_state.get("latest_failure")
latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
metadata = latest_failure.get("metadata")
metadata = metadata if isinstance(metadata, dict) else {}
meta = plan_state.get("meta") if isinstance(plan_state.get("meta"), dict) else {}
planner_repair = meta.get("planner_repair")

try:
    closed_marker_identity = _closed_fixer_marker_identity()
    marker_manifest_binding = _marker_manifest_binding()
    if closed_marker_identity is not None:
        # Make the authoritative marker projection visible to the renderer and
        # child process.  The launch module independently validates the same
        # pair, so a later environment mutation still fails closed.
        os.environ["ARNOLD_BABYSITTER_CHAIN_PROFILE"] = closed_marker_identity[0]
        os.environ["ARNOLD_BABYSITTER_CLOSED_PROFILE"] = closed_marker_identity[1]
        os.environ["ARNOLD_BABYSITTER_ROUTING"] = "omp"
        os.environ["ARNOLD_BABYSITTER_MODEL"] = (
            "omp:openrouter/meta/muse-spark-1.3-contributor:high"
        )
        os.environ["ARNOLD_BABYSITTER_OMP_MODEL"] = (
            "omp:openrouter/meta/muse-spark-1.3-contributor:high"
        )
        os.environ.pop("ARNOLD_BABYSITTER_CODEX_MODEL", None)
        os.environ.pop("ARNOLD_BABYSITTER_CODEX_INVESTIGATOR_MODEL", None)
    session_root = _session_engine_root()
    # Goal renderer: supervisor origin first so observer-mode prompt
    # fixes (coordination guard) ship immediately. Child PYTHONPATH
    # still binds to the target session's runtime_root.
    supervisor_roots: list[Path] = []
    origin = os.environ.get("ARNOLD_WATCHDOG_ORIGIN", "").strip()
    if origin:
        supervisor_roots.append(Path(origin).resolve().parents[4])
    for env_name in ("SRC_DIR", "ARNOLD_WATCHDOG_RUNTIME_SRC"):
        value = os.environ.get(env_name, "").strip()
        if value:
            supervisor_roots.append(Path(value))
    renderer_roots = list(supervisor_roots)
    if session_root is not None:
        renderer_roots.append(session_root)
    renderer = _resolve_renderer(renderer_roots or _superfixer_engine_roots())
    engine_root = session_root if session_root is not None else renderer.resolve().parents[5]
    babysitter_bin = _resolve_bin([engine_root, *supervisor_roots])
    run_id = "sched_superfixer_status_" + session.replace("/", "_")[:48] + "_" + digest
    _ns = _runpy.run_path(str(renderer))
    render_babysitter_goal = _ns.get("render_babysitter_goal")
    if not callable(render_babysitter_goal):
        raise RuntimeError("babysitter goal renderer is unavailable")
    goal_text = render_babysitter_goal(
        session,
        workspace=str(workspace),
        plan=resolved_plan_name,
        run_kind=run_kind,
        latest_failure=latest_failure if isinstance(latest_failure, dict) else None,
        planner_repair=planner_repair if isinstance(planner_repair, dict) else None,
        occurrence_digest=digest,
        recovery_dir=str(
            Path(workspace) / ".megaplan" / "plans" / ".chains" / "recovery"
        ),
    )
    goal_fd, goal_path = _tempfile.mkstemp(suffix=".md", prefix="superfixer-goal-")
    with os.fdopen(goal_fd, "w") as fh:
        fh.write(goal_text)
    run_root = repair_data_dir / "babysitter-runs" / run_id
    run_root.mkdir(parents=True, exist_ok=True)
    # Closed fixer identity is inherited from the manifest-bound chain launch
    # environment.  Never infer it from the (rotating/forgeable) session name.
    child_env = dict(os.environ)
    child_env["PYTHONPATH"] = str(engine_root)
    child_env["SRC_DIR"] = str(engine_root)
    child_env["ARNOLD_WATCHDOG_MANIFEST_RUNTIME_ROOT"] = str(engine_root)
    child_env["ARNOLD_WATCHDOG_RUNTIME_SRC"] = str(engine_root)
    child_env["ARNOLD_BABYSITTER_SESSION"] = session
    # ROOT FIX (grok consult 2026-08-17): the inherited box-global
    # ARNOLD_REPAIR_SESSION leaked into cross-session babysitter dispatches -
    # an astrid babysitter spawned by the mega watchdog's env carried
    # ARNOLD_REPAIR_SESSION=megaplan-maintenance into its resume/execute
    # workers, which hijacked the MEGA liveness lock/marker/lease. Remap the
    # repair session to the babysitter's target session so the liveness
    # resolver (liveness_lease.resolve_managed_session) sees consistency and
    # publishes under the correct session. Also clear the inherited owner pid
    # so the child never defers to a foreign live publisher.
    child_env["ARNOLD_REPAIR_SESSION"] = session
    child_env.pop("ARNOLD_LIVENESS_OWNER_PID", None)
    child_env.pop("ARNOLD_LIVENESS_OWNER_PROCESS_START", None)
    # Observer / foreign-epic pins must not survive into the child. The
    # session's own runtime_root is the engine; a leftover
    # ARNOLD_RUNTIME_MANIFEST would re-select the supervisor's epic.
    child_env.pop("ARNOLD_RUNTIME_MANIFEST", None)
    child_env["ARNOLD_BABYSITTER_MARKER_PATH"] = str(
        marker_dir / f"{session}.json"
    )
    if marker_manifest_binding is not None:
        child_env["ARNOLD_RUNTIME_MANIFEST"] = marker_manifest_binding[0]
        child_env["ARNOLD_BABYSITTER_MANIFEST_IDENTITY"] = marker_manifest_binding[1]
    child_env["ARNOLD_BABYSITTER_WORKSPACE"] = str(workspace)
    child_env["ARNOLD_BABYSITTER_PLAN"] = resolved_plan_name
    child_env["ARNOLD_BABYSITTER_RUN_KIND"] = run_kind
    child_env["ARNOLD_BABYSITTER_OCCURRENCE"] = digest
    # This explicit context scopes the final marker/chain admission door to
    # watchdog-originated automatic launches.  Direct/manual babysitter
    # invocations retain their established behavior.
    child_env["ARNOLD_BABYSITTER_AUTO_DISPATCH"] = "1"
    child_env["ARNOLD_BABYSITTER_GOAL_FILE"] = goal_path
    child_env["ARNOLD_BABYSITTER_MARKER_DIR"] = str(marker_dir)
    child_env["ARNOLD_BABYSITTER_REPAIR_DATA_DIR"] = str(repair_data_dir)
    stdout_fh = open(run_root / "babysitter.stdout.log", "ab")
    stderr_fh = open(run_root / "babysitter.stderr.log", "ab")
    try:
        launch = _subprocess.Popen(
            [
                str(babysitter_bin),
                "--goal-file", goal_path,
                "--session", session,
                "--workspace", str(workspace),
                "--plan", resolved_plan_name,
                "--run-kind", run_kind,
                "--occurrence", digest,
                "--remote-spec", str(remote_spec_raw or ""),
                "--run-id", run_id,
                "--run-root", str(run_root),
                "--mode", "superfixer",
            ],
            env=child_env,
            start_new_session=True,
            stdin=_subprocess.DEVNULL,
            stdout=stdout_fh,
            stderr=stderr_fh,
        )
    finally:
        stdout_fh.close()
        stderr_fh.close()
    # rc check + fail closed: a babysitter that dies immediately with a
    # non-zero rc means the launch did not take; journal and abort so the
    # caller never falls through to a deleted L1/L2 path.
    grace = float(os.environ.get("ARNOLD_BABYSITTER_LAUNCH_GRACE_SECS", "2"))
    deadline = _time.monotonic() + grace
    launch_rc = None
    while _time.monotonic() < deadline:
        launch_rc = launch.poll()
        if launch_rc is not None:
            break
        _time.sleep(0.05)
    if launch_rc is not None and launch_rc != 0:
        raise RuntimeError(f"babysitter exited early rc={launch_rc}")
    # A child that was durably suppressed exits 0 without a managed process.
    # Preserve that truthful outcome in the watchdog receipt; it is not a
    # scheduled launch and must not be reported as a provider failure.
    inner_receipt_path = run_root / f"{session}.babysitter-launch-receipt.json"
    inner_status = ""
    inner_dispatch = None
    try:
        inner_payload = _json.loads(inner_receipt_path.read_text())
        inner_status = str(inner_payload.get("status") or "")
        inner_dispatch = inner_payload.get("dispatch_outcome")
    except (OSError, ValueError):
        pass
    if launch_rc is not None and launch_rc == 0 and inner_status == "suppressed":
        suppressed_receipt = {
            "schema": "arnold.superfixer.watchdog_dispatch_receipt.v1",
            "session": session,
            "plan": resolved_plan_name,
            "run_id": run_id,
            "occurrence_digest": digest,
            "goal_path": goal_path,
            "renderer_path": str(renderer),
            "babysitter_bin": str(babysitter_bin),
            "engine_root": str(engine_root),
            "run_root": str(run_root),
            "dispatched_at": _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "status": "suppressed",
            "suppression_reason": "automatic babysitter admission authority",
            "dispatch_outcome": inner_dispatch,
        }
        if marker_manifest_binding is not None:
            suppressed_receipt["manifest_identity"] = marker_manifest_binding[1]
        _atomic_write(
            repair_data_dir / f"{session}.babysitter-receipt.json",
            _json.dumps(suppressed_receipt, indent=2, sort_keys=True) + "\n",
        )
        raise SystemExit(2)
    receipt = {
        "schema": "arnold.superfixer.watchdog_dispatch_receipt.v1",
        "session": session,
        "plan": resolved_plan_name,
        "run_id": run_id,
        "occurrence_digest": digest,
        "goal_path": goal_path,
        "renderer_path": str(renderer),
        "babysitter_bin": str(babysitter_bin),
        "engine_root": str(engine_root),
        "babysitter_pid": launch.pid,
        "run_root": str(run_root),
        "dispatched_at": _dt.datetime.now(_dt.timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%SZ"
        ),
        "status": "launched",
    }
    if marker_manifest_binding is not None:
        receipt["manifest_identity"] = marker_manifest_binding[1]
    _atomic_write(
        repair_data_dir / f"{session}.babysitter-receipt.json",
        _json.dumps(receipt, indent=2, sort_keys=True) + "\n",
    )
except SystemExit:
    raise
except Exception as _sfx:
    print(
        f"babysitter launch failed session={session} err={_sfx}",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
}

# The ONLY repair-dispatch gate in the watchdog (Q2 steps 2/5). Consults
# driver.babysitter (mode/after), dedups against a live babysitter for the
# same occurrence, launches the single-flash babysitter, and reports a typed
# status. Returns 0 in every case — the tick never falls through to a
# layered L1/L2 path.
babysitter_policy_dispatch() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local report_items="$6"
  local reason="${7:-unhealthy session}"
  local mode_after mode after digest
  mode_after="$(babysitter_effective_mode "$remote_spec" "$workspace" 2>>"${LOG:-/dev/null}" || true)"
  mode="${mode_after%%$'\t'*}"
  after="${mode_after#*$'\t'}"
  [[ -n "$mode" ]] || mode="superfixer"
  if [[ "$mode" == "off" ]]; then
    # `off` is an absolute action gate.  A parked/pre-execute stall is still
    # observed, never converted into an implicit babysitter launch.  This is
    # especially important for continuations that remain off until their
    # real provider/role probe has produced durable evidence.
    log "babysitter mode=off; observing without babysitter dispatch session=$session reason=$reason"
    report_item "$report_items" "$session" "repair" "babysitter_off" \
      "babysitter disabled for this chain (driver.babysitter.mode=off); $reason" \
      "$workspace" "$remote_spec"
    return 0
  fi
  digest="$(babysitter_occurrence_digest "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}" || true)"
  if [[ -n "$digest" ]]; then
    if babysitter_running_for_occurrence "$session" "$digest"; then
      log "babysitter already running for occurrence session=$session digest=$digest"
      report_item "$report_items" "$session" "repair" "babysitter_running" \
        "single-flash babysitter already running for this occurrence; observing" \
        "$workspace" "$remote_spec"
      return 0
    else
      local babysitter_status=$?
      if [[ "$babysitter_status" -eq 75 ]]; then
        log "babysitter cleanup hold blocks redispatch session=$session digest=$digest"
        report_item "$report_items" "$session" "repair" "cleanup_hold" \
          "confirmed babysitter wedge requires canonical cleanup reconciliation; no redispatch" \
          "$workspace" "$remote_spec"
        return 0
      fi
    fi
  fi
  if [[ -n "$after" ]] && ! babysitter_after_elapsed "$after" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
    log "babysitter after=$after not yet elapsed; observing session=$session reason=$reason"
    report_item "$report_items" "$session" "repair" "babysitter_waiting" \
      "babysitter after=$after not elapsed; observing unhealthy session: $reason" \
      "$workspace" "$remote_spec"
    return 0
  fi
  if launch_status_trigger_babysitter "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" "$digest"; then
    log "single-flash babysitter launched session=$session digest=$digest reason=$reason"
    report_item "$report_items" "$session" "repair" "babysitter_scheduled" \
      "single-flash babysitter dispatched: $reason" "$workspace" "$remote_spec"
  else
    local launch_status=$?
    if [[ "$launch_status" -eq 2 ]]; then
      log "single-flash babysitter suppressed by final authority door session=$session digest=$digest reason=$reason"
      report_item "$report_items" "$session" "repair" "babysitter_suppressed" \
        "single-flash babysitter dispatch suppressed by canonical pause/marker authority; no worker launched: $reason" "$workspace" "$remote_spec"
      return 0
    fi
    log "babysitter launch failed; no L1/L2 fallthrough session=$session reason=$reason"
    report_item "$report_items" "$session" "repair" "babysitter_launch_failed" \
      "babysitter launch failed; no L1/L2 fallthrough: $reason" "$workspace" "$remote_spec"
  fi
  return 0
}

