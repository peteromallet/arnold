  sleep "${MEGAPLAN_SUPERVISOR_TERM_WAIT_SECS:-0.5}"
  for pid in $pid_list; do
    kill -0 "$pid" >/dev/null 2>&1 || continue
    arnold_supervisor_bind_signal_context_for_pid "$pid" "$MARKER_DIR" non_worker "$root_pid" "${descendant_starts[$pid]}" || return 78
    arnold_supervisor_validate_descendant "$root_pid" "$pid" "${descendant_starts[$pid]}" || return 78
    arnold_supervisor_signal_bound_pid arnold-watchdog "$pid" SIGKILL kill repair-tree-stale >/dev/null 2>/dev/null || return $?
  done
  ! kill -0 "$root_pid" >/dev/null 2>&1
}

kill_repair_tree_complete() {
  local root_pid="$1"
  local root_pgid="$2"
  local groups group
  local tried=1
  [[ "$root_pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$root_pgid" =~ ^[0-9]+$ ]] || return 1
  groups="$(repair_tree_pgids "$root_pid" "$root_pgid" 2>/dev/null || true)"
  if [[ -z "$groups" ]]; then
    groups="$root_pgid"
  fi
  for group in $groups; do
    if kill_process_group "$group" "$root_pid"; then
      tried=0
    fi
  done
  if kill_pid_and_descendants "$root_pid"; then
    tried=0
  fi
  for group in $groups; do
    if kill -0 -- "-$group" >/dev/null 2>&1; then
      return 1
    fi
  done
  ! kill -0 "$root_pid" >/dev/null 2>&1 || return 1
  return "$tried"
}

reap_stale_repairs() {
  local report_items="$1"
  # Step 62: process-reaping family.  Reaping a stale or stalled repair
  # process may NEVER become accepted repair outside canonical simple_fixer
  # delegation; a forbidden authority source fails closed with a typed
  # zero-authority rejection (SC39).  The gate is fail-closed only for
  # forbidden sources; normal reaping proceeds otherwise.
  local _wrs_gate_json _wrs_gate_outcome
  _wrs_gate_json="$(watchdog_repair_state_authority_or_reject live_watchdog arnold-watchdog)" || true
  _wrs_gate_outcome="$(printf '%s' "$_wrs_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
  if [[ "$_wrs_gate_outcome" == "zero_authority_rejected" ]]; then
    authority_fail_closed "T62-PROCESS-REAP-01"
    return 0
  fi
  local ps_rows candidates marker_path workspace remote_spec
  local pid ppid pgid etimes kind session rule reason operator_dir stall_idle
  local live_pgid session_pgid method message
  declare -A seen_sessions=()
  declare -A seen_pgids=()
  ps_rows="$(mktemp)"
  candidates="$(mktemp)"
  ps -eww -o pid=,ppid=,pgid=,etimes=,args= 2>/dev/null > "$ps_rows"
  reap_stale_repair_candidates < "$ps_rows" \
    | awk -F'\t' 'BEGIN{OFS="\t"} {print $1,$2,$3,$4,$5,$6,$7,$8,"",""}' > "$candidates"
  reap_stalled_repair_candidates < "$ps_rows" >> "$candidates"
  while IFS=$'\t' read -r pid ppid pgid etimes kind session rule reason operator_dir stall_idle; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    export MEGAPLAN_NBF_CONTEXT_BOUND=0
    if [[ -n "$session" && -n "${seen_sessions[$session]:-}" ]]; then
      continue
    fi
    if [[ -n "${seen_pgids[$pgid]:-}" ]]; then
      continue
    fi
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      continue
    fi
    method=""
    session_pgid=""
    if [[ -n "$session" ]]; then
      marker_path="$(session_marker_path "$session")"
      # Reaping is target-scoped: a session marker is the only legal bridge
      # into the durable context. No marker means observe/report only.
      if [[ ! -f "$marker_path" ]] || ! arnold_supervisor_bind_signal_context_for_session "$session" "$MARKER_DIR" non_worker; then
        log "stale repair reap blocked: session marker authority unavailable session=$session"
        continue
      fi
      if [[ -r "$(kimi_pgid_path "$session")" ]]; then
        read -r session_pgid < "$(kimi_pgid_path "$session")" || session_pgid=""
        live_pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
        if [[ ! "$session_pgid" =~ ^[0-9]+$ || "$session_pgid" != "$live_pgid" ]]; then
          session_pgid=""
        fi
      fi
    else
      marker_path=""
      export MEGAPLAN_NBF_CONTEXT_BOUND=0
    fi
    if [[ -n "$session_pgid" ]] && kill_repair_tree_complete "$pid" "$session_pgid"; then
      method="session_pgid_complete:$session_pgid"
    elif kill_repair_tree_complete "$pid" "$pgid"; then
      method="pgid_complete:$pgid"
    elif kill_pid_and_descendants "$pid"; then
      method="pid_tree:$pid"
    else
      log "stale repair reap failed pid=$pid kind=$kind session=${session:-unknown} rule=$rule age=${etimes}s"
      continue
    fi
    workspace=""
    remote_spec=""
    if [[ -n "$marker_path" && -f "$marker_path" ]]; then
      workspace="$(json_field "$marker_path" workspace 2>/dev/null || true)"
      remote_spec="$(json_field "$marker_path" remote_spec 2>/dev/null || true)"
    fi
    message="reaped stale repair pid=$pid kind=$kind session=${session:-unknown} rule=$rule reason=$reason age=${etimes}s method=$method"
    if [[ "$rule" == "stalled" ]]; then
      message="$message idle=${stall_idle:-unknown}s"
      if [[ -n "$operator_dir" ]]; then
        message="$message operator_dir=$operator_dir"
      fi
    fi
    log "$message"
    report_item "$report_items" "${session:-}" "reap" "reaped" "$message" "$workspace" "$remote_spec"
    if [[ -n "$session" ]]; then
      kimi_dispatch_marker_clear "$session"
      seen_sessions["$session"]=1
    fi
    seen_pgids["$pgid"]=1
  done < "$candidates"
  rm -f "$ps_rows" "$candidates"
}

chain_current_pr_merged() {
  # Ground-truth check: is the chain's current-milestone PR merged LIVE (gh)?
  # Returns "merged", "open", or "unknown". Used to verify a stale
  # repair-exhausted marker: if the PR merged after the marker was written, the
  # chain can now reconcile+complete on relaunch, so the marker is stale.
  local workspace="$1" remote_spec="${2:-}"
  python3 - "$workspace" "$remote_spec" <<'PY'
import json
import pathlib
import subprocess
import sys

workspace = pathlib.Path(sys.argv[1])
plans_dir = workspace / ".megaplan" / "plans"
chain_paths = sorted(
    {
        *plans_dir.glob(".chains/*.json"),
        *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
        *(workspace / ".megaplan").glob("**/chain_state.json"),
    },
    key=lambda path: path.stat().st_mtime,
    reverse=True,
)
for path in chain_paths:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    pr_number = payload.get("pr_number")
    if not pr_number:
        continue
    try:
        proc = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "state"],
            cwd=workspace,
            check=False,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if proc.returncode != 0:
            continue
        state = json.loads(proc.stdout or "{}").get("state", "")
        state = state.lower() if isinstance(state, str) else ""
        print("merged" if state == "merged" else "open" if state == "open" else "unknown")
        raise SystemExit(0)
    except Exception:
        continue
print("unknown")
PY
}

chain_wait_status() {
  local workspace="$1"
  local remote_spec="${2:-}"
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$workspace" "$remote_spec" <<'PY'
import json
import os
import pathlib
import subprocess
import sys
import time

workspace = pathlib.Path(sys.argv[1])
remote_spec = sys.argv[2]
plans_dir = workspace / ".megaplan" / "plans"
chain_paths = sorted(
    {
        *plans_dir.glob(".chains/*.json"),
        *workspace.glob(".megaplan/initiatives/*/.megaplan/plans/.chains/*.json"),
        *(workspace / ".megaplan").glob("**/chain_state.json"),
    },
    key=lambda path: path.stat().st_mtime,
    reverse=True,
)


def _spec_path() -> pathlib.Path | None:
    if not remote_spec:
        return None
    path = pathlib.Path(remote_spec)
    if not path.is_absolute():
        path = workspace / path
    return path


def _merge_policy() -> str:
    path = _spec_path()
    if path is None:
        return ""
    try:
        for raw_line in path.read_text(encoding="utf-8").splitlines():
            line = raw_line.split("#", 1)[0].strip()
            if not line.startswith("merge_policy:"):
                continue
            value = line.split(":", 1)[1].strip().strip("'\"")
            if value == "manual":
                return "review"
            return value
    except Exception:
        return ""
    return ""


def _pr_state(pr_number: int) -> str:
    proc = subprocess.run(
        ["gh", "pr", "view", str(pr_number), "--json", "state"],
        cwd=workspace,
        check=False,
        capture_output=True,
        text=True,
        timeout=120,
    )
    if proc.returncode != 0:
        return ""
    state = json.loads(proc.stdout or "{}").get("state", "")
    return state.lower() if isinstance(state, str) else ""


def _run_merge_command(pr_number: int, *flags: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["gh", "pr", "merge", str(pr_number), *flags],
        cwd=workspace,
        check=False,
        capture_output=True,
        text=True,
        timeout=120,
    )


def _reference_census(root: str) -> tuple[str, list[str]]:
    """Canonical runtime reference census for *root* (T-0027).

    Fail-closed gate: ``(CLEAR, [])`` only when every reference store is
    readable and holds no exact reference to *root*; otherwise the verdict
    (``REFERENCED`` / ``DANGLING`` / ``UNKNOWN``) plus the census reasons.
    Callers MUST treat any non-CLEAR verdict as a hard deletion refusal —
    no route may treat ``--force`` / ``--auto`` as evidence of safety.

    Store dirs come from the SAME env vars as ``arnold-gc-sweep``
    (``ARNOLD_REFERENCE_CHAIN_STORE``, ``ARNOLD_REFERENCE_MARKER_STORE``,
    ``ARNOLD_REFERENCE_SCHEDULE_STORES``, ``ARNOLD_REFERENCE_REPAIR_QUEUE``,
    ``ARNOLD_REFERENCE_LEASE_STORE``, ``ARNOLD_RUNTIME_MANIFEST_DIR``,
    ``ARNOLD_BASE_DIR``) with the census module defaults as fallback, so
    tests sandbox the stores exactly like the sweep.  A raising or
    unavailable census is ``UNKNOWN`` — delete-on-unknown never happens.
    """
    try:
        from arnold_pipelines.megaplan.cloud.runtime_references import (
            DEFAULT_CHAIN_STORE,
            DEFAULT_LEASE_STORE,
            DEFAULT_MARKER_STORE,
            DEFAULT_REPAIR_QUEUE,
            DEFAULT_SCHEDULE_STORE,
            normalize_root,
            run_census,
        )
    except Exception as exc:  # pragma: no cover - defensive boundary
        return "UNKNOWN", [f"reference census unavailable: {exc}"]
    normalized = normalize_root(str(root))
    if not normalized:
        return "UNKNOWN", [f"root {root!r} is not an absolute runtime root"]
    try:
        return run_census(
            root=normalized,
            workspace=os.environ.get("ARNOLD_BASE_DIR", ""),
            manifest_store=os.environ.get(
                "ARNOLD_RUNTIME_MANIFEST_DIR", "/workspace/.megaplan"
            ),
            current_manifest="",
            chain_store=os.environ.get(
                "ARNOLD_REFERENCE_CHAIN_STORE", DEFAULT_CHAIN_STORE
            ),
            marker_store=os.environ.get(
                "ARNOLD_REFERENCE_MARKER_STORE", DEFAULT_MARKER_STORE
            ),
            schedule_store=os.environ.get(
                "ARNOLD_REFERENCE_SCHEDULE_STORES", DEFAULT_SCHEDULE_STORE
            ),
            repair_queue=os.environ.get(
                "ARNOLD_REFERENCE_REPAIR_QUEUE", DEFAULT_REPAIR_QUEUE
            ),
            lease_store=os.environ.get(
                "ARNOLD_REFERENCE_LEASE_STORE", DEFAULT_LEASE_STORE
            ),
        )
    except Exception as exc:  # pragma: no cover - defensive boundary
        return "UNKNOWN", [f"reference census raised: {exc}"]


def _census_note(message: str) -> None:
    # The watchdog's canonical log (LOG in the wrapper) is the durable writer
    # channel for the census refusal; never let a log failure mask the merge.
    log_path = os.environ.get("CLOUD_WATCHDOG_LOG", "/workspace/watchdog.log")
    try:
        with open(log_path, "a", encoding="utf-8") as handle:
            handle.write(f"[watchdog {time.strftime('%Y-%m-%dT%H:%M:%S%z')}] {message}\n")
    except Exception:
        pass


def _attempt_auto_merge(pr_number: int) -> None:
    subprocess.run(
        ["gh", "pr", "ready", str(pr_number)],
        cwd=workspace,
        check=False,
        capture_output=True,
        text=True,
        timeout=120,
    )
    # T-0027: the PR head branch must never be deleted while a runtime store
    # still references this checkout root (an open PR / manifest / job
    # reference is load-bearing).  REFERENCED / DANGLING / UNKNOWN all skip
    # the --delete-branch flag — fail-closed, the deletion is refused even
    # though the non-destructive merge itself proceeds.  CLEAR keeps the
    # existing route authority (merge + delete-branch).  The verdict gates
    # BOTH the auto attempt and the immediate-squash fallback below.
    census_verdict, census_reasons = _reference_census(str(workspace))
    delete_branch = census_verdict == "CLEAR"
    if not delete_branch:
        detail = "; ".join(census_reasons) or census_verdict
        _census_note(
            f"reference census {census_verdict}: refusing --delete-branch for "
            f"PR #{pr_number} head branch ({detail})"
        )
    proc = _run_merge_command(
        pr_number, "--auto", "--squash", *(["--delete-branch"] if delete_branch else [])
    )
    combined = f"{proc.stdout or ''} {proc.stderr or ''}"
    if proc.returncode == 0:
        return
    if "already checked out" in combined:
        _run_merge_command(pr_number, "--auto", "--squash")
        return
    if "Auto merge is not allowed" in combined:
        proc = _run_merge_command(
            pr_number, "--squash", *(["--delete-branch"] if delete_branch else [])
        )
        combined = f"{proc.stdout or ''} {proc.stderr or ''}"
        if proc.returncode != 0 and "already checked out" in combined:
            _run_merge_command(pr_number, "--squash")


for path in chain_paths:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    last_state = payload.get("last_state")
    pr_number = payload.get("pr_number")
    merge_policy = _merge_policy()
    finalized_review_wait = False
    if last_state == "awaiting_pr_merge":
        pass
    elif last_state == "finalized" and pr_number and merge_policy == "review":
        try:
            finalized_review_wait = _pr_state(int(pr_number)) == "open"
        except Exception:
            finalized_review_wait = False
        if not finalized_review_wait:
            continue
    else:
        # ``finalized`` is the pre-execute plan state, not completion evidence.
        # External merge authority is available only after the chain driver has
        # durably entered awaiting_pr_merge, except for a review-policy PR whose
        # external OPEN state proves that execution already crossed that
        # boundary. Never infer it from a terminal-looking label alone.
        continue
    if not pr_number:
        print("awaiting_pr_merge")
        raise SystemExit(0)
    try:
        pr_number_int = int(pr_number)
        if _pr_state(pr_number_int) == "merged":
            print("none")
            raise SystemExit(0)
        if merge_policy == "auto":
            _attempt_auto_merge(pr_number_int)
            if _pr_state(pr_number_int) == "merged":
                print("none")
                raise SystemExit(0)
    except Exception:
        pass
    print("awaiting_pr_merge")
    raise SystemExit(0)

print("none")
PY
}

resolve_existing_remote_spec() {
  local session="$1" workspace="$2" remote_spec="$3" run_kind="${4:-chain}"
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$run_kind" "$MARKER_DIR" <<'PY'
import json
import pathlib
import sys

session, workspace_raw, remote_spec_raw, run_kind, marker_dir_raw = sys.argv[1:]
workspace = pathlib.Path(workspace_raw)
marker_path = pathlib.Path(marker_dir_raw) / f"{session}.json"
remote_spec = pathlib.Path(remote_spec_raw) if remote_spec_raw else None
if remote_spec is not None and not remote_spec.is_absolute():
    remote_spec = workspace / remote_spec

if remote_spec is not None and remote_spec.exists():
    print(str(remote_spec))
    raise SystemExit(0)

patterns = []
if run_kind == "epic_chain":
    patterns.extend([
        ".megaplan/initiatives/*/assets/epic-chain.yaml",
        ".megaplan/initiatives/*/epic-chain.yaml",
    ])
patterns.extend([
    ".megaplan/initiatives/*/chain.yaml",
    ".megaplan/briefs/*/chain.yaml",
])

candidates: list[pathlib.Path] = []
for pattern in patterns:
    candidates.extend(path for path in workspace.glob(pattern) if path.is_file())

if not candidates:
