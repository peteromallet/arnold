    if babysitter_parked_chain_stall "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" 2>>"${LOG:-/dev/null}"; then
      log "session $session parked pre-execute; dispatching babysitter to drive"
      babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
        "parked pre-execute stall (plan born, no driver)"
      return 0
    fi
    log "session alive: $session"
    report_item "$report_items" "$session" "observe" "alive" "session already alive" "$workspace" "$remote_spec"
    return 0
  fi

  if [[ "$health" == "awaiting_pr_merge" ]]; then
    local pr_reconcile pr_reconcile_status pr_reconcile_message pr_gate_reason
    pr_reconcile="$(reconcile_awaiting_pr_merge "$session" "$workspace" "$remote_spec" 2>/dev/null || authority_gap_continue "T29-BYPASS-192" "authority-risk bypass converted to typed evidence gap")"
    IFS=$'\t' read -r pr_reconcile_status pr_reconcile_message <<< "$pr_reconcile"
    if [[ "$pr_reconcile_status" == "merged" ]]; then
      if [[ "$canonical_mutation_permitted" == "1" ]]; then
        rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-193" "authority-risk bypass converted to typed evidence gap"
      fi
      log "session awaiting PR merge reconciled merged; falling through to relaunch session=$session detail=$pr_reconcile_message"
    else
      log "session awaiting PR merge: $session detail=${pr_reconcile_message:-$pr_reconcile_status}"
      report_item "$report_items" "$session" "observe" "awaiting_pr_merge" "session waiting on PR merge: ${pr_reconcile_message:-$pr_reconcile_status}" "$workspace" "$remote_spec"
      PLAN_STATUS_PLAN_NAME="${PLAN_STATUS_PLAN_NAME:-$plan_name}"
      PLAN_STATUS_CURRENT_STATE="awaiting_pr_merge"
      # Queue write status (queued/duplicate/etc.) is observation metadata, not
      # gate identity. Excluding it keeps notification fingerprinting stable.
      pr_gate_reason="${pr_reconcile_message%% evidence=*}"
      PLAN_STATUS_AWAITING_HUMAN_REASON="PR merge boundary is still open: ${pr_gate_reason:-$pr_reconcile_status}"
      if canonical_mutation_fenced "PR-gate human escalation notification"; then
        return 0
      fi
      notify_needs_human \
        "$report_items" "$session" "$workspace" "$remote_spec" "$run_kind" "$health" \
        "awaiting_human halt; state=awaiting_pr_merge; reason=${PLAN_STATUS_AWAITING_HUMAN_REASON}" \
        "stable_human_gate"
      return 0
    fi
  fi

  if [[ "$run_kind" == "plan" ]]; then
    local terminal_status
    terminal_status="$(plan_terminal_status "$workspace" "$plan_name")"
    if [[ "$terminal_status" != "none" ]]; then
      local terminal_plan_name terminal_state
      IFS=$'\t' read -r terminal_plan_name terminal_state <<< "$terminal_status"
      log "plan complete; skipping repair/relaunch session=$session state=$terminal_state plan=$terminal_plan_name"
      report_item "$report_items" "$session" "observe" "complete" "plan complete" "$workspace" "$remote_spec"
      return 0
    fi
  fi

  local plan_status_env
  # If the helper emits nothing, keep the tick on the default non-attention path.
  plan_status_env="$(plan_attention_status_env "$workspace" "$remote_spec_path" "$run_kind" "$plan_name" 2>>"$LOG" || authority_gap_continue "T29-BYPASS-194" "authority-risk bypass converted to typed evidence gap")"
  if [[ -n "$plan_status_env" ]]; then
    eval "$plan_status_env"
  fi

  # --- custody structured facts ---
  # Emit custody classification evidence from the same observations the
  # watchdog already collects (active-step PID liveness, tmux/process health,
  # chain completion, relaunch command availability).  This turns what was
  # previously a prompt-only hint (stale_active_step text summary) into
  # structured facts consumers can act on mechanically.
  local custody_tmux_live custody_process_live custody_supervisor custody_watchdog_status
  custody_tmux_live=0
  custody_process_live=0
  custody_supervisor=""
  if arnold_supervisor_tmux_session_exists "$session"; then
    custody_tmux_live=1
  fi
  if [[ "$health" == "alive" ]]; then
    custody_process_live=1
  fi
  # supervisor_identity may be present in the marker; extract it defensively.
  custody_supervisor="$(json_field "$MARKER_DIR/$session.json" supervisor_identity 2>/dev/null || authority_gap_continue "T29-BYPASS-195" "authority-risk bypass converted to typed evidence gap")"
  custody_watchdog_status="$health"
  if [[ "$health" == "alive" ]]; then
    custody_watchdog_status="alive"
  elif [[ "$health" == "awaiting_pr_merge" ]]; then
    custody_watchdog_status="awaiting_pr_merge"
  fi
  PLAN_STATUS_CUSTODY_KIND=""
  PLAN_STATUS_CUSTODY_SESSION_ID=""
  PLAN_STATUS_CUSTODY_SUPERVISOR_IDENTITY=""
  PLAN_STATUS_CUSTODY_ACTIVE_STEP_PID_LIVE="0"
  PLAN_STATUS_CUSTODY_UNMANAGED_PROCESS="0"
  PLAN_STATUS_CUSTODY_LIVE_PROCESS_FINGERPRINTS=""
  PLAN_STATUS_CUSTODY_RELAUNCH_COMMAND_AVAILABLE="0"
  PLAN_STATUS_CUSTODY_FAILURE_REASONS=""
  PLAN_STATUS_CUSTODY_EVIDENCE_TIMESTAMP=""
  PLAN_STATUS_CUSTODY_CONTRACT_ID=""
  PLAN_STATUS_CUSTODY_BOUNDARY_ID=""
  emit_custody_structured_facts \
    "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" \
    "$custody_tmux_live" "$custody_process_live" \
    "${PLAN_STATUS_ACTIVE_STEP_PID_ALIVE:-}" \
    "${PLAN_STATUS_CHAIN_COMPLETE:-0}" \
    "${custody_supervisor:-}" \
    "${relaunch_command:-}" \
    "${PLAN_STATUS_AWAITING_HUMAN:-0}" \
    "0" \
    "${custody_watchdog_status:-unknown}"

  if [[ "$run_kind" == "chain" && "${PLAN_STATUS_CURRENT_STATE:-}" == "done" && "${PLAN_STATUS_CHAIN_COMPLETE:-0}" == "1" ]]; then
    log "chain complete; skipping repair/relaunch session=$session state=done"
    report_item "$report_items" "$session" "observe" "complete" "chain complete" "$workspace" "$remote_spec"
    return 0
  fi
  if [[ "${PLAN_STATUS_CURRENT_STATE:-}" == "paused" ]]; then
    log "session paused by durable plan state; skipping repair/relaunch session=$session plan=${PLAN_STATUS_PLAN_NAME:-$plan_name}"
    report_item "$report_items" "$session" "observe" "paused" "durable plan state is paused; no runner expected until explicit resume" "$workspace" "$remote_spec"
    return 0
  fi
  if [[ "$resolver_human_verdict" == provider_retry:* ]]; then
    log "audit recovery selected one provider retry session=$session gate=${resolver_human_verdict#provider_retry:}"
    report_item "$report_items" "$session" "recovery" "provider_retry_selected" "audit-only retry selected for typed provider gate ${resolver_human_verdict#provider_retry:}" "$workspace" "$remote_spec"
  fi
  if [[ "$canonical_mutation_permitted" == "1" && "$resolver_human_verdict" != provider_retry:* ]] && emit_current_needs_human_sidecar "$report_items" "$session" "$workspace" "$remote_spec" "${PLAN_STATUS_PLAN_NAME:-$plan_name}" "$current_target_observation" "$health"; then
    return 0
  fi
  if [[ "$health" == "stopped" && "${PLAN_STATUS_ACTIVE_STEP_PRESENT:-0}" == "1" && "${PLAN_STATUS_ACTIVE_STEP_PID_ALIVE:-}" != "1" ]]; then
    # A leftover active_step record with a dead PID is NOT liveness.  On a
    # DRIVEABLE plan (initialized/planned/finalized/critiqued/gated) that is
    # not human-gated, the step died with its container (or was never really
    # live in this namespace): the plan is READY to drive, not a repair.
    # Routing it to the stale-active-step bucket fenced the babysitter behind
    # canonical-mutation fencing forever (grok consult 2026-08-17: after the
    # resident-only container recreate killed the astrid m3 execute worker,
    # the watchdog logged 'canonical target liveness is UNKNOWN; fenced
    # action=stale-active-step babysitter dispatch' on every scan and never
    # dispatched — the plan state was finalized/driveable, not a stale step).
    case "${PLAN_STATUS_CURRENT_STATE:-}" in
      initialized|planned|finalized|critiqued|gated)
        if [[ "${PLAN_STATUS_AWAITING_HUMAN:-0}" != "1" ]]; then
          log "driveable plan with dead leftover active-step PID; dispatching drive session=$session state=${PLAN_STATUS_CURRENT_STATE:-unknown}"
          # Direct drive dispatch.  The leftover active_step record (dead
          # worker in a foreign container namespace) makes
          # babysitter_parked_chain_stall return false, but the plan is
          # driveable and NOT human-gated — the between-milestones drive is
          # the non-destructive, unfenced path that gets it moving again.
          babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
            "driveable plan with dead leftover worker: ${PLAN_STATUS_PLAN_NAME:-unknown} in state ${PLAN_STATUS_CURRENT_STATE:-unknown}"
          return 0
        fi
        ;;
    esac
    local stale_active_summary
    stale_active_summary="stale_active_step: plan=${PLAN_STATUS_PLAN_NAME:-unknown}; state=${PLAN_STATUS_CURRENT_STATE:-unknown}; phase=${PLAN_STATUS_ACTIVE_STEP_PHASE:-unknown}; worker_pid=${PLAN_STATUS_ACTIVE_STEP_WORKER_PID:-none} not live"
    emit_watchdog_incident_bridge_event "detection" "$session" "$workspace" "$remote_spec" "$stale_active_summary" "stale_active_step" "immediate_repair"

    # --- stale active-step custody fact ---
    # When worker PID is present but not alive, emit a structured custody fact
    # alongside the existing text summary so consumers (S4 status, auditor) can
    # classify the custody state mechanically without parsing free text.
    report_item "$report_items" "$session" "custody" "stale_active_step" \
      "custody_kind=${PLAN_STATUS_CUSTODY_KIND:-unknown}; active_step_pid_alive=0; worker_pid=${PLAN_STATUS_ACTIVE_STEP_WORKER_PID:-none}" \
      "$workspace" "$remote_spec"
    if canonical_mutation_fenced "stale-active-step babysitter dispatch"; then
      return 0
    fi
    babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
      "stale active step: $stale_active_summary"
    return 0
  fi
  if [[ "${PLAN_STATUS_STATE_MISMATCH:-0}" == "1" ]]; then
    local mismatch_summary
    mismatch_summary="${PLAN_STATUS_STATE_MISMATCH_SUMMARY:-plan/chain state mismatch detected}"
    emit_watchdog_incident_bridge_event "detection" "$session" "$workspace" "$remote_spec" "$mismatch_summary" "state_mismatch" "immediate_repair"
    if canonical_mutation_fenced "state-mismatch babysitter dispatch"; then
      return 0
    fi
    babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
      "state mismatch: $mismatch_summary"
    return 0
  fi
  if [[ "$resolver_human_verdict" != provider_retry:* && "${PLAN_STATUS_AWAITING_HUMAN:-0}" == "1" ]]; then
    local human_summary repair_summary
    human_summary="awaiting_human halt; state=${PLAN_STATUS_CURRENT_STATE:-unknown}; reason=${PLAN_STATUS_AWAITING_HUMAN_REASON:-plan is awaiting human action}"
    if [[ -n "${PLAN_STATUS_FAILURE_KIND:-}" ]]; then
      human_summary="$human_summary; failure=${PLAN_STATUS_FAILURE_KIND}"
    fi
    if [[ -n "${PLAN_STATUS_TIERS_TRIED:-}" ]]; then
      human_summary="$human_summary; tiers=${PLAN_STATUS_TIERS_TRIED}"
    fi
    if [[ -n "${PLAN_STATUS_PUSHED_COMMITS:-}" ]]; then
      human_summary="$human_summary; commits=${PLAN_STATUS_PUSHED_COMMITS}"
    fi
    if [[ "$resolver_human_verdict" == suppress:* ]]; then
      # The canonical resolver suppressed the human gate and admitted a
      # machine-repair disposition (old resolver L1). The ONLY repair
      # dispatch is the single-flash babysitter.
      if canonical_mutation_fenced "resolver babysitter dispatch"; then
        return 0
      fi
      babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
        "resolver suppressed human gate: ${resolver_human_verdict#suppress:}; $human_summary"
      return 0
    fi
    if [[ -f "$(repair_needs_human_path "$session")" ]]; then
      local stale_marker_plans
      stale_marker_plans="$(repair_needs_human_matches_current_plan "$session" "${PLAN_STATUS_PLAN_NAME:-}" 2>/dev/null)" || {
        rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-197" "authority-risk bypass converted to typed evidence gap"
        log "stale repair needs-human marker cleared; live current plan supersedes marker session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown} marker_plans=${stale_marker_plans:-unknown}"
      }
      if [[ -n "${stale_marker_plans:-}" ]]; then
        compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "true" "$stale_marker_plans"
      else
        compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
      fi
      if [[ -f "$(repair_needs_human_path "$session")" ]] && command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "${PLAN_STATUS_PLAN_NAME:-}"; then
        rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-198" "authority-risk bypass converted to typed evidence gap"
        log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
      fi
      if [[ -f "$(repair_needs_human_path "$session")" ]]; then
        repair_summary="$(repair_needs_human_summary "$session")"
        log "session awaits human action; preserving matching repair evidence without suppressing typed gate session=$session summary=$repair_summary"
      fi
    fi
    log "session reached stable human gate; notifying without repair or relaunch session=$session plan=${PLAN_STATUS_PLAN_NAME:-} summary=$human_summary"
    if canonical_mutation_fenced "human escalation notification"; then
      report_item "$report_items" "$session" "observe" "awaiting_human" "$human_summary" "$workspace" "$remote_spec"
      return 0
    fi
    notify_needs_human \
      "$report_items" "$session" "$workspace" "$remote_spec" "$run_kind" "$health" \
      "$human_summary" "stable_human_gate"
    return 0
  fi
  if [[ "$resolver_human_verdict" != provider_retry:* && "${PLAN_STATUS_MANUAL_REVIEW:-0}" == "1" ]]; then
    local human_summary manual_review_origin
    manual_review_origin="${PLAN_STATUS_MANUAL_REVIEW_ORIGIN:-}"
    human_summary="manual_review halt; state=${PLAN_STATUS_CURRENT_STATE:-unknown}; retry=${PLAN_STATUS_RETRY_STRATEGY:-unknown}; failure=${PLAN_STATUS_FAILURE_KIND:-unknown}"
    if [[ -n "$manual_review_origin" ]]; then
      human_summary="$human_summary; origin=$manual_review_origin"
    fi
    if [[ -n "${PLAN_STATUS_FAILURE_MESSAGE:-}" ]]; then
      human_summary="$human_summary; detail=${PLAN_STATUS_FAILURE_MESSAGE}"
    fi
    if [[ -n "${PLAN_STATUS_TIERS_TRIED:-}" ]]; then
      human_summary="$human_summary; tiers=${PLAN_STATUS_TIERS_TRIED}"
    fi
    if [[ -n "${PLAN_STATUS_PUSHED_COMMITS:-}" ]]; then
      human_summary="$human_summary; commits=${PLAN_STATUS_PUSHED_COMMITS}"
    fi
    if [[ "$resolver_human_verdict" == suppress:* ]]; then
      # The canonical resolver suppressed the human gate and admitted a
      # machine-repair disposition (old resolver L1). The ONLY repair
      # dispatch is the single-flash babysitter.
      if canonical_mutation_fenced "resolver babysitter dispatch"; then
        return 0
      fi
      babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
        "resolver suppressed human gate: ${resolver_human_verdict#suppress:}; $human_summary"
      return 0
    fi
    if [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "blocked_recovery_not_resolved" ]] \
      || [[ "${PLAN_STATUS_DISPATCH_DECISION:-}" == "dispatch_l1_repair" ]] \
      || [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "review_quality_blocked_unknown" ]] \
      || [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "quality_gate_blocked" ]] \
      || [[ "${PLAN_STATUS_FAILURE_KIND:-}" == "quality_gate_circuit_open" ]] \
      || [[ "$manual_review_origin" == "auto_stall" || "$manual_review_origin" == "auto_stall_legacy" ]]; then
      # manual_review classified for repair dispatch (blocked_recovery,
      # dispatch_l1_repair, review-quality block kinds, auto_stall).
      # review_quality_blocked_unknown / quality_gate_blocked /
      # quality_gate_circuit_open are the typed review-quality block kinds
      # (recovery_policy.classify_error_kind maps all three to the
      # review_quality_block repair class) — they carry repairable evidence,
      # NOT a genuine human gate: they must reach the single-flash babysitter
      # instead of parking at needs-human observe (F3 dispatch-gap; codex rec
      # #4). A durable needs-human marker that survives the fresh-classifier
      # checks below is reported as-is.
      if [[ -f "$(repair_needs_human_path "$session")" ]]; then
        local stale_marker_plans
        stale_marker_plans="$(repair_needs_human_matches_current_plan "$session" "${PLAN_STATUS_PLAN_NAME:-}" 2>/dev/null)" || {
          rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-200" "authority-risk bypass converted to typed evidence gap"
          log "stale repair needs-human marker cleared; live current plan supersedes marker session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown} marker_plans=${stale_marker_plans:-unknown}"
        }
        if [[ -n "${stale_marker_plans:-}" ]]; then
          compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "true" "$stale_marker_plans"
        else
          compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
        fi
        if [[ -f "$(repair_needs_human_path "$session")" ]] && command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "${PLAN_STATUS_PLAN_NAME:-}"; then
          rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-201" "authority-risk bypass converted to typed evidence gap"
          log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
        fi
        if [[ -f "$(repair_needs_human_path "$session")" ]]; then
          local repair_summary
          repair_summary="$(repair_needs_human_summary "$session")"
          log "session auto-stalled into manual_review and repair loop already requested human session=$session summary=$repair_summary"
          report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
          return 0
        fi
      fi
      if canonical_mutation_fenced "manual-review babysitter dispatch"; then
        return 0
      fi
      babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
        "manual_review classified for repair dispatch: $human_summary"
      return 0
    fi
    log "session requires human review session=$session plan=${PLAN_STATUS_PLAN_NAME:-} summary=$human_summary"
    if canonical_mutation_fenced "manual-review escalation notification"; then
      report_item "$report_items" "$session" "observe" "needs_human" "$human_summary" "$workspace" "$remote_spec"
      return 0
    fi
    notify_needs_human "$report_items" "$session" "$workspace" "$remote_spec" "$run_kind" "$health" "$human_summary"
    return 0
  fi

  # The repair loop leaves a persistent sidecar after 3 bounded failures so the
  # watchdog reports needs-human instead of immediately re-arming automation.
  # Ground-truth guard: that marker reflects a PAST exhaustion. If the chain's
  # current-milestone PR has since MERGED, the chain can now reconcile+complete
  # on relaunch, so the marker is stale -- clear it and fall through to the
  # relaunch path instead of suppressing it with a stale needs_human.
  if [[ "$resolver_human_verdict" != provider_retry:* && -f "$(repair_needs_human_path "$session")" ]]; then
    if [[ "$canonical_mutation_permitted" != "1" ]]; then
      local repair_summary
      repair_summary="$(repair_needs_human_summary "$session")"
      log "session marked needs human by repair loop; canonical UNKNOWN preserves marker read-only session=$session summary=$repair_summary"
      report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
      return 0
    fi
    if [[ "$run_kind" == "chain" ]] && [[ "$(chain_current_pr_merged "$workspace" "$remote_spec")" == "merged" ]]; then
      rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-202" "authority-risk bypass converted to typed evidence gap"
      log "stale repair marker cleared; current milestone PR merged, falling through to relaunch session=$session"
    elif ! repair_needs_human_matches_current_plan "$session" "${PLAN_STATUS_PLAN_NAME:-}" >/dev/null 2>&1; then
      rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-203" "authority-risk bypass converted to typed evidence gap"
      log "stale repair needs-human marker cleared; live current plan supersedes marker session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
      compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "true" ""
    elif sibling_alive="$(workspace_has_other_alive_session "$session" "$workspace" 2>/dev/null)"; then
      rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-204" "authority-risk bypass converted to typed evidence gap"
      log "stale repair needs-human marker cleared; sibling session is alive session=$session sibling=$sibling_alive"
      compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
    elif command -v repair_needs_human_should_remain_human >/dev/null 2>&1 && ! repair_needs_human_should_remain_human "$session" "${PLAN_STATUS_PLAN_NAME:-}"; then
      rm -f "$(repair_needs_human_path "$session")" 2>/dev/null || authority_gap_continue "T29-BYPASS-205" "authority-risk bypass converted to typed evidence gap"
      log "stale repair needs-human marker cleared; fresh classifier no longer requires human session=$session live_plan=${PLAN_STATUS_PLAN_NAME:-unknown}"
      compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
    else
      local repair_summary
      repair_summary="$(repair_needs_human_summary "$session")"
      log "session marked needs human by repair loop session=$session summary=$repair_summary"
      report_item "$report_items" "$session" "observe" "needs_human" "$repair_summary" "$workspace" "$remote_spec"
      compare_needs_human_to_resolver "$session" "${PLAN_STATUS_PLAN_NAME:-}" "false" ""
      return 0
    fi
  fi

  # NOTE: a missing chain/epic-chain spec here was previously handled by
  # dispatching the L1 repair loop. That path is now retired by the env-gone
  # gate above (after spec resolution) — a wiped spec means no environment to
  # repair, so we never reach this point with a missing spec.

  local sibling_alive
  if [[ "$health" == "stopped" ]] && sibling_alive="$(workspace_has_other_alive_session "$session" "$workspace" 2>/dev/null)"; then
    log "stopped session superseded by live sibling; skipping relaunch session=$session sibling=$sibling_alive"
    report_item "$report_items" "$session" "observe" "superseded" "live sibling session owns workspace: $sibling_alive" "$workspace" "$remote_spec"
    return 0
  fi

  if [[ "$health" == "stopped" ]]; then
    emit_watchdog_incident_bridge_event "detection" "$session" "$workspace" "$remote_spec" "session stopped and needs repair attention" "stopped" "immediate_repair"
  else
    emit_watchdog_incident_bridge_event "detection" "$session" "$workspace" "$remote_spec" "session unhealthy and needs repair attention: $health" "$health" "immediate_repair"
  fi
  if canonical_mutation_fenced "repair/relaunch"; then
    return 0
  fi

  # P2/G3: the direct mechanical relaunch is a typed fallback.  Journal
  # fallback_considered + fallback_taken BEFORE the marker write and the tmux
  # launch; a ledger write failure blocks the marker write AND the launch
  # (no event = no side effect).  Missing workspace/spec/digest already fail
  # closed inside the emitter (returns 1).
  emit_mechanical_relaunch_fallback_events() {
    if declare -F emit_runtime_transition_event >/dev/null 2>&1; then
      if ! emit_runtime_transition_event fallback_considered \
        "$session" "$workspace" "$remote_spec" \
        "availability" "" \
        "" "${REPAIR_DISPATCH_RUNTIME_SRC:-$SRC_DIR}" "${request_id:-}" \
        "watchdog considered direct mechanical relaunch session=$session"; then
        log "runtime fallback_considered ledger write failed; blocking direct mechanical relaunch session=$session"
        return 1
      fi
      if ! emit_runtime_transition_event fallback_taken \
        "$session" "$workspace" "$remote_spec" \
        "availability" "" \
        "" "${REPAIR_DISPATCH_RUNTIME_SRC:-$SRC_DIR}" "${request_id:-}" \
        "watchdog took direct mechanical relaunch fallback session=$session"; then
        log "runtime fallback_taken ledger write failed; blocking direct mechanical relaunch session=$session"
        return 1
      fi
    fi
    return 0
  }

  # Q2 step 4/5: the ONLY repair dispatch in the watchdog is the single-flash
  # babysitter (mode-gated by driver.babysitter). Stage 0 is stopped-only,
  # first-stop-only: a first stop gets ONE direct mechanical tmux relaunch
  # (the same input may just have needed a nudge); everything else repairable
  # — stopped AFTER Stage 0 (the old "flap"), retrying_failure,
  # chain_log_failure, plan/chain unhealthy, state mismatch, stale active
  # step — goes to the babysitter. There is no L1/L2 fallthrough.
  if [[ "$health" == "stopped" ]]; then
    if mechanical_relaunch_attempted_previously "$session"; then
      log "session stopped after mechanical relaunch; dispatching single-flash babysitter session=$session health=$health"
      babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
        "session stopped after mechanical relaunch (health=$health)"
      return 0
    fi
    # Stage 0: first stop only -> direct mechanical relaunch below. The
    # .kimi-dispatch marker (without pgid) records the attempted relaunch so
    # the next stop escalates to the babysitter above.
    log "session stopped; mechanical relaunch first session=$session"
    if ! emit_mechanical_relaunch_fallback_events; then
      report_item "$report_items" "$session" "restart" "restart_blocked" "direct mechanical relaunch blocked: runtime transition ledger write failed" "$workspace" "$remote_spec"
      return 0
    fi
    kimi_dispatch_marker_set "$session"
  else
    log "session unhealthy; dispatching single-flash babysitter session=$session health=$health"
    babysitter_policy_dispatch "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$report_items" \
      "session unhealthy and needs repair attention (health=$health)"
    return 0
  fi

  # G5 (T-0021/T-0022): the engine-root preflight is hoisted to the top of the
  # tick (FIRST mutation-gating step) — it already failed closed before any
  # current-target subprocess, marker, publication, or repair side effect, so
  # no re-check is needed here before the install-repair/tmux-kill side effects.
  ensure_install_or_repair || log "editable install still unhealthy; relaunching anyway"
  if arnold_supervisor_tmux_session_exists "$session"; then
    log "killing stale tmux session before relaunch: $session"
    if ! arnold_supervisor_bind_signal_context_for_session "$session" "$MARKER_DIR" non_worker; then
      log "stale tmux session cleanup blocked: session marker authority unavailable"
      return 1
    fi
    session_snapshot="$(arnold_supervisor_tmux_session_snapshot "$session" 2>/dev/null)" || {
      log "stale tmux session cleanup blocked: exact session snapshot unavailable"
      return 1
    }
    IFS=$'	' read -r tmux_socket tmux_socket_fingerprint tmux_server_pid tmux_server_start tmux_session_id tmux_session_name tmux_pane_records tmux_pane_digest <<< "$session_snapshot"
    session_pane_record="$(arnold_supervisor_tmux_owned_pane "$session" "$MEGAPLAN_NBF_MARKER_PATH" "$tmux_socket")" || {
      log "stale tmux session cleanup blocked: no marker-owned pane proof"
      return 1
    }
    IFS='|' read -r tmux_pane_id session_pane_pid tmux_pane_start tmux_command_digest <<< "$session_pane_record"
    [[ "$tmux_session_name" == "$session" ]] || return 1
    if [[ "$session_pane_pid" =~ ^[0-9]+$ ]] \
      && arnold_supervisor_signal_bound_pid arnold-watchdog "$session_pane_pid" SIGTERM term stale-tmux-session >/dev/null 2>/dev/null; then
      sleep "${MEGAPLAN_SUPERVISOR_TERM_WAIT_SECS:-0.5}"
      if arnold_supervisor_signal_bound_pid arnold-watchdog "$session_pane_pid" SIGKILL kill stale-tmux-session >/dev/null 2>/dev/null \
        && arnold_supervisor_tmux_session_revalidate "$session" "$tmux_socket" "$tmux_socket_fingerprint" "$tmux_server_pid" "$tmux_server_start" "$tmux_session_id" "$tmux_session_name" "$tmux_pane_digest" >/dev/null 2>/dev/null; then
        tmux -S "$tmux_socket" kill-session -t "=$tmux_session_id" 2>/dev/null || return 1
        if tmux -S "$tmux_socket" has-session -t "=$tmux_session_id" >/dev/null 2>&1; then
          return 1
        fi
      else
        log "stale tmux session cleanup blocked: KILL confirmation or identity unavailable"
        return 1
      fi
    else
      log "stale tmux session cleanup blocked: TERM confirmation or identity unavailable"
      return 1
    fi
    for _ in 1 2 3 4 5; do
      tmux -S "$tmux_socket" has-session -t "=$tmux_session_id" 2>/dev/null || break
      sleep 0.2
    done
  fi

  local safe log_relative launch_script quoted_command quoted_command_shell
  safe="$(safe_name "$session")"
  launch_script="$(mktemp)"
  quoted_command="$(resolve_relaunch_command "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" "$relaunch_command")" || {
    log "unable to determine relaunch command session=$session kind=$run_kind"
    report_item "$report_items" "$session" "restart" "needs_attention" "unable to determine relaunch command" "$workspace" "$remote_spec"
    rm -f "$launch_script"
    return 1
  }
  # Step 53: gate the resolved relaunch command before it is wrapped in an
  # arnold-supervise bash -lc script.  The gate proves a successful relaunch
  # (rc=0) cannot become accepted repair outside canonical simple_fixer
  # delegation; authority is never derived from a label, liveness signal, WBC
  # receipt, or rebuildable projection (SC19).
  if ! relaunch_materializer_authority_gate "$quoted_command" \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("is_non_authoritative_family") and not d.get("forbidden_sources_present") else 1)' 2>/dev/null; then
    authority_gap_continue "T37-RELAUNCH-MATERIALIZER" "relaunch command failed non-authoritative materializer gate"
  fi
  printf -v quoted_command_shell '%q' "$quoted_command"
  cat > "$launch_script" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd $(printf '%q' "$workspace")
unset ARNOLD_LIVENESS_OWNER_PID ARNOLD_LIVENESS_OWNER_PROCESS_START
export ARNOLD_REPAIR_QUEUE_ROOT=$(printf '%q' "${ARNOLD_REPAIR_QUEUE_ROOT:-$REPAIR_QUEUE_DIR}")
export ARNOLD_REPAIR_MARKER_DIR=$(printf '%q' "$MARKER_DIR")
export ARNOLD_REPAIR_SESSION=$(printf '%q' "$session")
export ARNOLD_REPAIR_RUN_KIND=$(printf '%q' "$run_kind")
export ARNOLD_SUPERVISE_SESSION=$(printf '%q' "$session")
export ARNOLD_SUPERVISE_WORKSPACE=$(printf '%q' "$workspace")
export ARNOLD_SUPERVISE_REMOTE_SPEC=$(printf '%q' "$remote_spec")
export ARNOLD_SUPERVISE_RUN_KIND=$(printf '%q' "$run_kind")
exec /usr/local/bin/arnold-supervise "watchdog-$safe" bash -lc $quoted_command_shell
EOF
  chmod +x "$launch_script"

  # Launches are target-scoped too: a marker-bound socket is mandatory even
  # when no prior session exists. Never fall back to tmux's ambient/default
  # server, which could create a session in another authority namespace.
  local launch_tmux_socket
  launch_tmux_socket="$(arnold_supervisor_tmux_session_socket "$session" 2>/dev/null)" || {
    log "relaunch blocked: marker-bound tmux socket unavailable session=$session"
    report_item "$report_items" "$session" "restart" "restart_failed" "marker-bound tmux socket unavailable" "$workspace" "$remote_spec"
    rm -f "$launch_script"
    return 1
  }
  log "relaunching stopped session=$session kind=$run_kind spec=$remote_spec"
  tmux -S "$launch_tmux_socket" new-session -d -s "$session" -c "$workspace" "bash '$launch_script'" || {
    if arnold_supervisor_tmux_session_exists "$session"; then
      local race_health
      if ! declare -F verify_relaunch_health >/dev/null 2>&1; then
        race_health="modular_invocation_unverified"
        log "relaunch raced with existing tmux session; verifier unavailable in modular invocation session=$session"
        report_item "$report_items" "$session" "restart" "restarted" "session exists after relaunch race; health verifier unavailable in modular invocation" "$workspace" "$remote_spec"
      elif race_health="$(verify_relaunch_health "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"; then
        log "relaunch raced with existing tmux session; verified health=$race_health session=$session"
        report_item "$report_items" "$session" "restart" "restarted" "session exists after relaunch race" "$workspace" "$remote_spec"
      else
        # No L1/L2 fallthrough: the next tick observes the stopped session
        # with the mechanical-relaunch marker and dispatches the babysitter.
        log "relaunch raced with existing tmux session but substantive launch failed health=$race_health session=$session"
        report_item "$report_items" "$session" "restart" "restart_failed" "session exists after relaunch race but launch health=$race_health" "$workspace" "$remote_spec"
        rm -f "$launch_script"
        return 1
      fi
      rm -f "$launch_script"
      return 0
    fi
    log "failed to relaunch $session"
    report_item "$report_items" "$session" "restart" "restart_failed" "tmux relaunch failed" "$workspace" "$remote_spec"
    rm -f "$launch_script"
    return 1
  }
  local verified_health
  if ! declare -F verify_relaunch_health >/dev/null 2>&1; then
    # launch_chain_tick is extracted in isolation by focused shell contract
    # tests. The deployed wrapper always defines the verifier above.
    verified_health="modular_invocation_unverified"
    report_item "$report_items" "$session" "restart" "restarted" "stopped session relaunched" "$workspace" "$remote_spec"
    return 0
  elif verified_health="$(verify_relaunch_health "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"; then
    log "relaunch ground-truth verification passed session=$session health=$verified_health"
    report_item "$report_items" "$session" "restart" "restarted" "stopped session relaunched" "$workspace" "$remote_spec"
    return 0
  fi
  log "relaunch did not produce a healthy runner session=$session health=$verified_health"
  report_item "$report_items" "$session" "restart" "restart_failed" "tmux relaunch did not produce a healthy runner; health=$verified_health" "$workspace" "$remote_spec"
  # No L1/L2 fallthrough: the next tick observes the stopped session with the
  # mechanical-relaunch marker and dispatches the babysitter.
  emit_watchdog_incident_bridge_event "repair_failure" "$session" "$workspace" "$remote_spec" "mechanical relaunch failed ground-truth verification: $verified_health" "$verified_health" "babysitter"
  return 1
}

scan_once_unlocked() {
  log "scan start marker_dir=$MARKER_DIR"
  maybe_reexec_updated_watchdog
  local report_items
  report_items="$(mktemp)"
  # Validate the observation/runtime path before any repair-trigger or status
  # scan. If the watchdog cannot import its own cloud modules, never continue
  # silently on a stale report.
  if ! bootstrap_watchdog_observation "$report_items"; then
    emit_report "$report_items" 0
    rm -f "$report_items"
    return 1
  fi
  # A heartbeat means observation readiness succeeded, not merely that the
  # shell process reached the beginning of a sweep.
  write_watchdog_heartbeat
  # P2: heartbeat + an early snapshot write BEFORE the heavy/stall-prone work
  # (git sync, pip refresh). If anything below hangs, the cache is at most
  # ~one sweep stale instead of frozen indefinitely. The early write uses last
  # sweep's report and is "notrack" (best-effort, not counted toward
  # escalation); the authoritative write at sweep end still counts. The
  # layered repair-trigger scan was removed with the L1 stack; the babysitter
  # dispatches directly from launch_chain_tick.
  write_status_snapshot "" "" "" notrack
  if [[ "${WATCHDOG_BOOTSTRAP_RECOVERED:-0}" != "1" ]]; then
    sync_editable_source_branch "$report_items" || authority_gap_continue "T29-BYPASS-208" "authority-risk bypass converted to typed evidence gap"
  fi
  maybe_reexec_updated_watchdog
  while IFS=$'\t' read -r adopted_session adopted_workspace adopted_remote_spec adopted_kind adopted_plan_name; do
    [[ -n "$adopted_session" ]] || continue
    log "unbound tmux candidate is diagnostic-only and was not adopted session=$adopted_session kind=${adopted_kind:-chain}"
    report_item "$report_items" "$adopted_session" "observe" "unbound_candidate" "marker-less tmux session was not adopted; canonical identity binding required" "$adopted_workspace" "$adopted_remote_spec"
  done < <(adopt_unmarked_tmux_sessions)
  if [[ ! -d "$MARKER_DIR" ]]; then
    log "scan complete: marker directory missing"
    emit_report "$report_items" 0
    write_status_snapshot
    rm -f "$report_items"
    return 0
  fi

  local found=0
  # Canonical sidecars ignored here: *.progress.json|*.reap-progress.json|*.repair-progress.json|*.chain-health.progress.json
  while IFS= read -r marker; do
    [[ -n "$marker" ]] || continue
    found=$((found + 1))
    local session workspace remote_spec run_kind plan_name relaunch_command
    session="$(json_field "$marker" session 2>/dev/null)" || {
      log "flag invalid marker (missing session): $marker"
      report_item "$report_items" "" "flag" "setup_invalid" "missing session: $marker"
      continue
    }
    workspace="$(json_field "$marker" workspace 2>/dev/null)" || {
      log "flag invalid marker (missing workspace): $marker"
      report_item "$report_items" "$session" "flag" "workspace_missing" "missing workspace: $marker"
      continue
    }
    remote_spec="$(json_field "$marker" remote_spec 2>/dev/null)" || {
      log "flag invalid marker (missing remote_spec): $marker"
      report_item "$report_items" "$session" "flag" "setup_invalid" "missing remote_spec: $marker" "$workspace"
      continue
    }
    run_kind="$(json_field "$marker" run_kind 2>/dev/null || true)"
    plan_name="$(json_field "$marker" plan_name 2>/dev/null || true)"
    relaunch_command="$(json_field "$marker" relaunch_command 2>/dev/null || true)"
    launch_chain_tick "$session" "$workspace" "$remote_spec" "$report_items" "${run_kind:-chain}" "$plan_name" "$relaunch_command" || authority_gap_continue "T29-BYPASS-212" "authority-risk bypass converted to typed evidence gap"
  done < <(PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" <<'PY'
import pathlib
import sys

from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path

marker_dir = pathlib.Path(sys.argv[1])
for path in sorted(marker_dir.glob("*.json")):
    if is_canonical_session_marker_path(path):
        print(path)
PY
)
  local retention_result
  retention_result="$(run_repair_data_maintenance 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-213" "authority-risk bypass converted to typed evidence gap")"
  if [[ "$retention_result" == RAN:* ]]; then
    log "repair-data maintenance complete cleanup_id=${retention_result#RAN:}"
  elif [[ "$retention_result" == LOCK_BUSY ]]; then
    log "repair-data maintenance skipped; ordinary repair lock active"
  fi
  reap_stale_repairs "$report_items"
  log "scan complete markers=$found"
  emit_report "$report_items" "$found"
  write_status_snapshot
  rm -f "$report_items"
}

scan_once() {
  local scan_lock_fd scan_rc
  if ! arnold_runtime_attestation_check watchdog; then
    arnold_supervisor_failure_artifact watchdog "runtime_attestation_stale"
    log "scan refused: runtime launch attestation is stale"
    return 78
  fi
  mkdir -p "$(dirname "$SCAN_LOCK_FILE")"
  if command -v flock >/dev/null 2>&1; then
    exec {scan_lock_fd}>"$SCAN_LOCK_FILE"
    if [[ "$COOPERATIVE_ONCE" == "1" ]]; then
      if ! flock -w "$SCAN_LOCK_WAIT_SECS" "$scan_lock_fd"; then
        log "audit recovery scan lock timed out lock=$SCAN_LOCK_FILE wait_secs=$SCAN_LOCK_WAIT_SECS"
        exec {scan_lock_fd}>&-
        return 75
      fi
    elif ! flock -n "$scan_lock_fd"; then
      log "scan skipped; another watchdog sweep owns lock=$SCAN_LOCK_FILE"
      exec {scan_lock_fd}>&-
      return 75
    fi
  fi

  write_watchdog_sweep_health started || return 74
  scan_once_unlocked
  scan_rc=$?
  if [[ $scan_rc -eq 0 ]]; then
    write_watchdog_sweep_health completed || scan_rc=74
  else
    write_watchdog_sweep_health failed || authority_gap_continue "T29-BYPASS-214" "authority-risk bypass converted to typed evidence gap"
  fi
  if [[ -n "${scan_lock_fd:-}" ]]; then
    flock -u "$scan_lock_fd" 2>/dev/null || true
    exec {scan_lock_fd}>&-
  fi
  return "$scan_rc"
}

log "starting (interval=${INTERVAL}s marker_dir=$MARKER_DIR repair=$REPAIR_ENABLED push=$PUSH_REPAIRS report=$REPORT_PATH)"
while true; do
  scan_once
  scan_rc=$?
  if [[ "$ONCE" == "--once" ]]; then
    exit "$scan_rc"
  fi
  sleep "$INTERVAL"
done
