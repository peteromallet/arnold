resolve_relaunch_command() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local relaunch_command="${6:-}"

  # A chain marker commonly preserves its original `chain start` command and
  # omits plan_name. Once the active plan records explicit resume authority,
  # that current state must outrank the stale launch-time marker command.
  if [[ "$run_kind" != "plan" ]]; then
    local resume_rc
    chain_resume_plan_relaunch_command_if_needed "$workspace" "$plan_name" "$remote_spec" "$session" || resume_rc=$?
    # G5 (T-0021): the engine-root preflight runs first inside the resume
    # check; a typed drift (24) must fail closed here rather than fall
    # through to the marker/default relaunch paths.
    if [[ "${resume_rc:-0}" -eq 24 ]]; then
      return 24
    fi
    if [[ "${resume_rc:-0}" -eq 0 ]]; then
      return 0
    fi
  fi
  # G5 (round-6 finding 1b): the default-plan preflight gates ANY persisted
  # plan command before it is returned verbatim — a persisted command cannot
  # bypass the engine-root preflight (chain commands are already gated by the
  # preflight inside the resume check above).
  if [[ "$run_kind" == "plan" && -n "$relaunch_command" ]]; then
    chain_engine_root_preflight "$workspace" "" "$session" "$plan_name" >/dev/null || return $?
  fi
  # G5 (round-2 finding 2): the blacklist gate below (relaunch_resolution)
  # also rejects shared-root PYTHONPATH=/workspace/arnold patterns, so a
  # persisted builder-selection command is never returned verbatim — it is
  # regenerated from the preflight-accepted manifest root or fails closed
  # (typed drift 24) instead.  G5 (round-14 finding 1): the gate additionally
  # passes the accepted manifest root so a persisted command referencing a
  # DIFFERENT per-epic runtime path is regenerated, not returned verbatim.
  if [[ -n "$relaunch_command" ]] && ! stale_marker_relaunch_command "$relaunch_command" "$SRC_DIR"; then
    printf '%s' "$relaunch_command"
    return 0
  fi
  if [[ "$run_kind" == "plan" ]]; then
    [[ -n "$plan_name" ]] || return 1
    default_plan_relaunch_command "$plan_name" "$workspace" "$session"
    return 0
  fi
  default_chain_relaunch_command "$session" "$workspace" "$remote_spec"
}

# Step 53 relaunch-materializer authority gate.
#
# Every relaunch command and arnold-supervise bash -lc script produced by this
# watchdog is a NON-AUTHORITATIVE relaunch materializer: a successful relaunch
# (return code 0) resumes plan/chain execution but can never become accepted
# repair.  Accepted repair requires canonical simple_fixer delegation with an
# exact F01 occurrence tuple; authority is never derived from a label, liveness
# signal, WBC receipt, or rebuildable projection (SC19).
#
# The gate classifies a relaunch command into a closed vocabulary of
# non-authoritative families and proves no forbidden authority source is
# present.  Output is a single JSON object on stdout.
relaunch_materializer_authority_gate() {
  local relaunch_command="${1:-}"
  python3 - "$relaunch_command" <<'GATE_PY'
import json
import re
import sys

cmd = sys.argv[1] if len(sys.argv) > 1 else ""

NON_AUTHORITATIVE_FAMILIES = (
    "direct_module.auto",
    "direct_module.resume",
    "direct_module.auto_or_resume",
    "direct_module.chain_start",
    "arnold_supervise.bash_lc",
)

_DIRECT_MODULE_RE = re.compile(
    r"python3\b.*?\s+-m\s+arnold_pipelines\.megaplan\s+(\S+)"
)
_SUPERVISE_RE = re.compile(r"arnold-supervise\b.*?\sbash\s+-lc\b")

_FORBIDDEN_AUTHORITY_SOURCES = (
    ("label", re.compile(r"--authority-label|REPAIR_AUTHORITY_LABEL|repair-authority-label")),
    ("liveness", re.compile(r"repair_accepted|accepted_repair_on|repair.*\$\?|repair.*returncode")),
    ("wbc_receipt", re.compile(r"wbc[-_ ]?receipt|well[-_ ]?behaved[-_ ]?client")),
    (
        "rebuildable_projection",
        re.compile(r"rebuildable[-_ ]?projection|reproject[-_ ]?authority"),
    ),
)


def _classify(command):
    if _SUPERVISE_RE.search(command):
        return "arnold_supervise.bash_lc"
    match = _DIRECT_MODULE_RE.search(command)
    if match:
        verb = match.group(1).strip("\"'")
        tail = command[match.end():]
        if verb in ("auto", "resume"):
            return "direct_module." + verb
        if verb == "chain" and tail.lstrip().startswith("start"):
            return "direct_module.chain_start"
        if "PLAN_CMD" in verb:
            return "direct_module.auto_or_resume"
    return ""


family = _classify(cmd)
forbidden_present = [
    name
    for name, pattern in _FORBIDDEN_AUTHORITY_SOURCES
    if pattern.search(cmd)
]
result = dict(
    family=family,
    is_non_authoritative_family=family in NON_AUTHORITATIVE_FAMILIES,
    is_repair_authority=False,
    can_become_accepted_repair_on_success=False,
    accepted_repair_requires_canonical_delegation=True,
    canonical_delegation_path="simple_fixer.singleton_claim.exact_f01_tuple",
    forbidden_authority_sources=[
        "label",
        "liveness",
        "wbc_receipt",
        "rebuildable_projection",
    ],
    forbidden_sources_present=forbidden_present,
)
print(json.dumps(result))
GATE_PY
}

child_agent_launch_authority_or_reject() {
  # Step 55-58: classify a watchdog child-agent launch (repair-loop, meta-repair,
  # managed-agent, or Kimi family).  A child launch may NEVER become accepted
  # repair outside canonical simple_fixer delegation; authority is never derived
  # from a label, liveness signal, WBC receipt, or rebuildable projection (SC38).
  # Forbidden sources emit a typed zero-authority rejection; exact-F01 occurrences
  # delegate to the simple_fixer singleton claim with no child agent fan-out.
  # Emits JSON on stdout with an ``outcome`` key in
  # {zero_authority_rejected, delegated, no_authority_claim}.
  local caller_kind="${1:-live_watchdog}"
  local caller_id="${2:-arnold-watchdog}"
  local _py_root="${WRAPPER_REPO_ROOT:-${ARNOLD_SRC:-}}"
  PYTHONSAFEPATH=1 PYTHONPATH="${_py_root:+$_py_root:}${PYTHONPATH:-}" python3 -P - \
    "$caller_kind" "$caller_id" <<'CHILD_AGENT_PY'
import json, os, sys
from arnold_pipelines.megaplan.cloud.wrappers.repair_delegation import (
    build_repair_delegation, emit_zero_authority_rejection,
)
from arnold_pipelines.megaplan.custody.contracts import F01_REPAIR_OCCURRENCE_FIELDS

caller_kind = sys.argv[1] if len(sys.argv) > 1 else "live_watchdog"
caller_id = sys.argv[2] if len(sys.argv) > 2 else "arnold-watchdog"

forbidden = dict(
    authority_label=os.environ.get("ARNOLD_REPAIR_AUTHORITY_LABEL", ""),
    liveness_receipt=os.environ.get("ARNOLD_REPAIR_LIVENESS_RECEIPT", ""),
    wbc_receipt=os.environ.get("ARNOLD_REPAIR_WBC_RECEIPT", ""),
    rebuildable_projection=os.environ.get("ARNOLD_REPAIR_REBUILDABLE_PROJECTION", ""),
)
if any(v for v in forbidden.values()):
    result = emit_zero_authority_rejection(
        caller_kind, caller_id,
        reason="child-agent launch authority derived from forbidden source: "
               + ",".join(sorted(k for k, v in forbidden.items() if v)),
    )
    print(json.dumps({
        "outcome": result.outcome,
        "delegated": False,
        "child_agent_fanout": False,
        "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
    }))
    sys.exit(0)

f01_env = os.environ.get("ARNOLD_REPAIR_F01_OCCURRENCE", "")
target = {}
if f01_env:
    try:
        target = json.loads(f01_env)
    except Exception:
        target = {}

if not target:
    print(json.dumps({
        "outcome": "no_authority_claim",
        "delegated": False,
        "child_agent_fanout": False,
        "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
    }))
    sys.exit(0)

for name in F01_REPAIR_OCCURRENCE_FIELDS:
    target.setdefault(name, "")

delegation = build_repair_delegation(caller_kind, caller_id, target)
if delegation is None:
    result = emit_zero_authority_rejection(
        caller_kind, caller_id,
        reason="child-agent launch path could not construct exact F01 occurrence tuple",
    )
    print(json.dumps({
        "outcome": result.outcome,
        "delegated": False,
        "child_agent_fanout": False,
        "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
    }))
    sys.exit(0)

print(json.dumps({
    "outcome": "delegated",
    "delegated": True,
    "child_agent_fanout": False,
    "canonical_delegation_path": "simple_fixer.singleton_claim.exact_f01_tuple",
    "occurrence_fingerprint": delegation.occurrence.occurrence_fingerprint,
}))
CHILD_AGENT_PY
}

