sync_extra_cloud_skills() {
  if [[ ! -d "$EXTRA_SKILLS_DIR" ]]; then
    log "extra cloud skills dir missing at $EXTRA_SKILLS_DIR; skipping"
    return 0
  fi

  local target_dirs=(
    "$HOME/.claude/skills"
    "$HOME/.codex/skills"
    "$HOME/.agents/skills"
  )
  local skill_dir name target_dir dest created skipped updated
  created=0
  skipped=0
  updated=0
  log "syncing extra cloud skills from $EXTRA_SKILLS_DIR"
  for skill_dir in "$EXTRA_SKILLS_DIR"/*/; do
    [[ -d "$skill_dir" && -f "$skill_dir/SKILL.md" ]] || continue
    name="$(basename "$skill_dir")"
    for target_dir in "${target_dirs[@]}"; do
      mkdir -p "$target_dir"
      dest="$target_dir/$name"
      if [[ -L "$dest" ]]; then
        ln -sfn "$skill_dir" "$dest"
        updated=$((updated + 1))
      elif [[ -e "$dest" ]]; then
        skipped=$((skipped + 1))
      else
        ln -s "$skill_dir" "$dest"
        created=$((created + 1))
      fi
    done
  done
  log "extra cloud skills synced created=$created updated=$updated skipped=$skipped"
}

sync_editable_source_branch() {
  local report_items="$1"
  if [[ "$SYNC_ENABLED" != "1" ]]; then
    log "editable source sync disabled"
    report_item "$report_items" "editable-install" "sync" "skipped" "sync disabled" "$SRC_DIR" "$SYNC_BRANCH"
    return 0
  fi
  if [[ -z "$SYNC_BRANCH" ]]; then
    log "editable source sync skipped; no branch configured"
    report_item "$report_items" "editable-install" "sync" "sync_failed" "no sync branch configured" "$SRC_DIR"
    return 1
  fi

  ensure_editable_source_checkout || {
    report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout unavailable" "$SRC_DIR" "$SYNC_BRANCH"
    return 1
  }

  if [[ ! -d "$SRC_DIR/.git" ]]; then
    report_item "$report_items" "editable-install" "sync" "sync_failed" "source checkout missing git metadata" "$SRC_DIR" "$SYNC_BRANCH"
    return 1
  fi

  local before after status branch
  before="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
  log "syncing editable source branch=$SYNC_BRANCH dir=$SRC_DIR before=$before"
  (
    cd "$SRC_DIR" &&
    git config --global --add safe.directory "$SRC_DIR" >/dev/null 2>&1 || authority_gap_continue "T29-BYPASS-136" "authority-risk bypass converted to typed evidence gap" &&
    timeout "$SYNC_TIMEOUT_SECS" git fetch origin "$SYNC_BRANCH" --prune &&
    branch="$(git branch --show-current)" &&
    if [[ "$branch" != "$SYNC_BRANCH" ]]; then
      if [[ -n "$(git status --porcelain)" ]]; then
        echo "cannot switch from $branch to $SYNC_BRANCH: checkout has local changes" >&2
        exit 12
      fi
      git checkout "$SYNC_BRANCH"
    fi &&
    timeout "$SYNC_TIMEOUT_SECS" git pull --ff-only origin "$SYNC_BRANCH"
  ) >> "$LOG" 2>&1 || {
    log "editable source fetch/pull failed"
    report_item "$report_items" "editable-install" "sync" "sync_failed" "fetch/pull failed" "$SRC_DIR" "$SYNC_BRANCH"
    return 1
  }

  sync_skills_in_source "$SRC_DIR" || {
    report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync failed" "$SRC_DIR" "$SYNC_BRANCH"
    return 1
  }

  status="$(cd "$SRC_DIR" && git status --porcelain -- arnold_pipelines/megaplan/skills)"
  if [[ -n "$status" ]]; then
    log "committing editable skill sync drift"
    (
      cd "$SRC_DIR" &&
      git add -A -- arnold_pipelines/megaplan/skills &&
      git commit -m "Sync cloud editable install and skills" &&
      timeout "$SYNC_TIMEOUT_SECS" git push origin "$SYNC_BRANCH"
    ) >> "$LOG" 2>&1 || {
      log "editable skill sync commit/push failed"
      report_item "$report_items" "editable-install" "sync" "sync_failed" "skill sync commit/push failed" "$SRC_DIR" "$SYNC_BRANCH"
      return 1
    }
  else
    log "editable source has no skill sync drift to push"
  fi

  status="$(cd "$SRC_DIR" && git status --porcelain)"
  if [[ -n "$status" ]]; then
    log "editable source has non-sync drift; leaving uncommitted"
    report_item "$report_items" "editable-install" "sync" "sync_dirty" "source checkout has non-sync drift; not auto-committing" "$SRC_DIR" "$SYNC_BRANCH"
  fi

  refresh_editable_install || {
    log "editable install refresh after sync failed"
    report_item "$report_items" "editable-install" "sync" "sync_failed" "refresh failed" "$SRC_DIR" "$SYNC_BRANCH"
    return 1
  }

  after="$(cd "$SRC_DIR" && git rev-parse --short HEAD 2>/dev/null || true)"
  report_item "$report_items" "editable-install" "sync" "synced" "editable source branch synced and refreshed ($before -> $after)" "$SRC_DIR" "$SYNC_BRANCH"

  # ── Codex 2026-08-17: fail-closed promotion transaction ────────────────
  # Replace the unconditional auto-advance. Publication of source and
  # activation of a runtime generation are ONE atomic transaction. On any
  # failure the old generation G stays dispatchable; the checkout being at
  # G+1 must NOT invalidate a running G.
  if [[ -n "$before" && -n "$after" && "$before" != "$after" && -n "${ARNOLD_RUNTIME_MANIFEST:-}" && -f "${ARNOLD_RUNTIME_MANIFEST:-}" ]]; then
    candidate_full="$(cd "$SRC_DIR" && git rev-parse "refs/remotes/origin/$SYNC_BRANCH" 2>/dev/null || true)"
    local_head="$(cd "$SRC_DIR" && git rev-parse HEAD 2>/dev/null || true)"
    if [[ -z "$candidate_full" || ${#candidate_full} -ne 40 ]]; then
      log "promotion refused: cannot resolve full SHA of refs/remotes/origin/$SYNC_BRANCH"
    elif [[ "$local_head" != "$candidate_full" ]]; then
      log "promotion refused: local HEAD ($local_head) != origin/$SYNC_BRANCH ($candidate_full)"
    elif [[ -n "$(cd "$SRC_DIR" && git status --porcelain)" ]]; then
      log "promotion refused: checkout is not clean"
    else
      # The Python mutation seam owns the canonical promotion+ordinary lock
      # pair.  Do not hold the promotion lock in this shell while spawning
      # Python: the child would inherit the descriptor and deadlock trying to
      # acquire the same canonical lock for its fresh read/CAS/write.
      PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$ARNOLD_RUNTIME_MANIFEST" "$candidate_full" "$SRC_DIR" "$before" "$after" <<'PY' >> "$LOG" 2>&1
import sys
from pathlib import Path
from arnold_pipelines.megaplan.cloud.runtime_manifest import (
    advance_generation_at_path, load_manifest,
)
from arnold_pipelines.megaplan.cloud.install_sync import ensure_dependency_generation

manifest_path, new_commit, runtime_root, before, after = sys.argv[1:6]
manifest = load_manifest(Path(manifest_path))
# no-op when already at the candidate generation
if str(manifest.epic.get("expected_head") or "") == new_commit:
    print("promotion no-op: manifest already at", new_commit)
    sys.exit(0)
# build/select the matching content-addressed dependency generation for the
# candidate checkout's frozen spec BEFORE advancing (fail-closed).
generations_root = Path(__import__("os").environ.get("ARNOLD_GENERATIONS_ROOT", "/workspace/.megaplan/generations"))
proof = ensure_dependency_generation(runtime_root, generations_root)
advanced, status = advance_generation_at_path(
    Path(manifest_path),
    new_commit,
    reason=f"promotion after engine sync ({before} -> {after})",
    dependency_generation=proof,
    expected=(str(manifest.runtime_id), int(manifest.generation), str(manifest.epic.get("expected_head") or "")),
    idempotent_when_pinned=True,
)
print("promotion", status, "generation", advanced.generation, "head", new_commit)
PY
      rc=$?
      if [[ $rc -eq 0 ]]; then
        log "manifest promotion succeeded after engine sync ($before -> $after)"
      else
        log "manifest promotion FAILED (rc=$rc) after engine sync; old generation stays dispatchable"
      fi
    fi
  fi
}

codex_repair_editable_install() {
  local reason="$1"
  if [[ "$REPAIR_ENABLED" != "1" ]]; then
    log "editable install check failed; repair disabled (set ARNOLD_REPAIR_TRIGGER_ENABLED=1): $reason"
    return 1
  fi
  if [[ ! -d "$SRC_DIR/.git" ]]; then
    log "Codex repair skipped; source checkout missing at $SRC_DIR"
    return 1
  fi
  if ! command -v codex >/dev/null 2>&1; then
    log "Codex repair skipped; codex CLI unavailable"
    return 1
  fi

  local prompt reason_digest source_repair_id
  prompt="$(mktemp)"
  cat > "$prompt" <<EOF
You are running inside an Arnold cloud worker. The editable Arnold install failed this watchdog check:

$reason

Working directory: $SRC_DIR

Fix only the Arnold source checkout so the cloud worker can import and run:
python3 -c "import arnold_pipelines.megaplan.cloud.cli"

The editable install checkout must stay on branch $SYNC_BRANCH. Do not use
MEGAPLAN_REF or the active workflow checkout branch to choose the repair branch.

Keep the patch narrowly scoped. Run the smallest relevant verification. Do not ask for input.
EOF
  redact_file_in_place "$prompt"
  reason_digest="$(printf '%s' "$reason" | sha256sum | awk '{print $1}')"
  source_repair_id="watchdog-source-repair:${reason_digest}"

  log "starting Codex editable-install repair in $SRC_DIR"
  # Step 57: managed-agent launches may NEVER become accepted repair outside
  # canonical simple_fixer delegation.  Classify the launch before forking the
  # Codex managed-agent process (SC38).
  _child_gate_json="$(child_agent_launch_authority_or_reject live_watchdog arnold-watchdog)" || true
  _child_gate_outcome="$(printf '%s' "$_child_gate_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("outcome",""))' 2>/dev/null || true)"
  if [[ "$_child_gate_outcome" == "zero_authority_rejected" ]]; then
    authority_fail_closed "T57-MANAGED-AGENT-FANOUT-01"
    log "Codex editable-install managed-agent launch rejected by child-agent authority gate: $_child_gate_json"
    return 1
  fi
  (
    cd "$SRC_DIR" &&
    python3 -m arnold_pipelines.megaplan.managed_agent run \
      --run-kind automatic_watchdog_source_repair \
      --identity-key "$source_repair_id" \
      --project-dir "$SRC_DIR" \
      --task-kind debugging \
      --difficulty 8 \
      --model "$CODEX_REPAIR_MODEL" \
      --reasoning-effort high \
      --route-class watchdog_editable_install_repair \
      --backend codex \
      --command-display "watchdog editable-install Codex repair" \
      --origin-kind watchdog_source_repair \
      --origin-id "$source_repair_id" \
      --origin-component arnold-watchdog \
      --trigger-id "$reason_digest" \
      --lineage-key watchdog-source-repair \
      --stdin-file "$prompt" \
      --require-output \
      --link phase=editable_install_repair \
      -- timeout "$CODEX_TIMEOUT" codex exec --sandbox danger-full-access \
        -c model="$CODEX_REPAIR_MODEL" -c model_reasoning_effort=high -
  ) >> "$LOG" 2>&1
  local rc=$?
  rm -f "$prompt"
  if [[ $rc -ne 0 ]]; then
    log "Codex repair failed rc=$rc"
    return "$rc"
  fi

  if ! (cd "$SRC_DIR" && python3 - <<'PY' >> "$LOG" 2>&1
import arnold_pipelines.megaplan.cloud.cli  # noqa: F401
PY
  ); then
    log "Codex repair completed but import check still fails"
    return 1
  fi

  if (cd "$SRC_DIR" && git diff --quiet && git diff --cached --quiet); then
    log "Codex repair produced no source changes"
    return 0
  fi

  (
    cd "$SRC_DIR" &&
    git add -A &&
    git commit -m "Fix cloud editable install from watchdog"
  ) >> "$LOG" 2>&1 || {
    log "repair commit failed"
    return 1
  }

  if [[ "$PUSH_REPAIRS" == "1" ]]; then
    log "pushing watchdog repair commit"
    (cd "$SRC_DIR" && git push) >> "$LOG" 2>&1 || {
      log "repair push failed"
      return 1
    }
  else
    log "repair committed locally; push disabled (set CLOUD_WATCHDOG_PUSH_REPAIRS=1)"
  fi
}

