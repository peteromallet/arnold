#!/usr/bin/env bash
set -uo pipefail

# The resident watchdog can outlive multiple source activations.  Bash parses
# large scripts lazily, so run from one validated immutable snapshot and retain
# the origin path separately for source/sibling reconciliation.
ARNOLD_WATCHDOG_ORIGIN="${ARNOLD_WATCHDOG_ORIGIN:-${BASH_SOURCE[0]:-$0}}"
if [[ "${ARNOLD_WATCHDOG_SNAPSHOT_ACTIVE:-0}" != "1" ]]; then
  watchdog_snapshot="$(mktemp "${TMPDIR:-/tmp}/arnold-watchdog.XXXXXXXX")"
  if ! cp -- "$ARNOLD_WATCHDOG_ORIGIN" "$watchdog_snapshot" \
    || ! bash -n "$watchdog_snapshot"; then
    rm -f -- "$watchdog_snapshot"
    echo "arnold-watchdog: immutable wrapper snapshot failed validation" >&2
    exit 78
  fi
  export ARNOLD_WATCHDOG_ORIGIN
  export ARNOLD_WATCHDOG_SNAPSHOT_ACTIVE=1
  exec bash "$watchdog_snapshot" "$@"
fi
ARNOLD_WATCHDOG_SNAPSHOT_PATH="${BASH_SOURCE[0]:-$0}"
# The snapshot may be re-exec'd by the relaunch materializer (exec via
# arnold-supervise) while ARNOLD_WATCHDOG_ORIGIN still names the shared
# origin file.  The EXIT trap must NEVER remove the origin: it is a tracked
# engine file every future launch depends on.  Only ever remove a real
# mktemp snapshot under the temp dir, and only when it is not the origin.
trap '
  case "$ARNOLD_WATCHDOG_SNAPSHOT_PATH" in
    "${TMPDIR:-/tmp}"/arnold-watchdog.*)
      if [[ -n "${ARNOLD_WATCHDOG_ORIGIN:-}" && "$ARNOLD_WATCHDOG_SNAPSHOT_PATH" != "$ARNOLD_WATCHDOG_ORIGIN" ]]; then
        rm -f -- "$ARNOLD_WATCHDOG_SNAPSHOT_PATH"
      fi ;;
  esac
' EXIT

# Caller-provided supervisor runtime controls are an explicit invocation
# contract (and are used by readiness probes).  The shared hot-env supplies
# defaults for resident service launches, but must not overwrite those explicit
# values when the wrapper is invoked with a constrained runtime.
WATCHDOG_CALLER_SUPERVISOR_PYTHON_SET="${MEGAPLAN_SUPERVISOR_PYTHON+x}"
WATCHDOG_CALLER_SUPERVISOR_PYTHON="${MEGAPLAN_SUPERVISOR_PYTHON-}"
WATCHDOG_CALLER_RUNTIME_REQUIRED_SET="${MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED+x}"
WATCHDOG_CALLER_RUNTIME_REQUIRED="${MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED-}"
WATCHDOG_CALLER_OBSERVER="${ARNOLD_WATCHDOG_OBSERVER-}"

WATCHDOG_HOT_ENV="${ARNOLD_CLOUD_HOT_ENV:-/workspace/.cloud-hot-env}"
if [[ -f "$WATCHDOG_HOT_ENV" ]]; then
  set -a
  # shellcheck disable=SC1091
  . "$WATCHDOG_HOT_ENV"
  set +a
fi

if [[ -n "$WATCHDOG_CALLER_SUPERVISOR_PYTHON_SET" ]]; then
  MEGAPLAN_SUPERVISOR_PYTHON="$WATCHDOG_CALLER_SUPERVISOR_PYTHON"
  export MEGAPLAN_SUPERVISOR_PYTHON
fi
if [[ -n "$WATCHDOG_CALLER_RUNTIME_REQUIRED_SET" ]]; then
  MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED="$WATCHDOG_CALLER_RUNTIME_REQUIRED"
  export MEGAPLAN_SUPERVISOR_RUNTIME_REQUIRED
fi
# Observer mode is a caller contract: hot-env must not re-pin a per-epic
# manifest / repair session onto a marker-scoped supervisor.
if [[ "${WATCHDOG_CALLER_OBSERVER:-}" == "1" || "${ARNOLD_WATCHDOG_OBSERVER:-}" == "1" ]]; then
  export ARNOLD_WATCHDOG_OBSERVER=1
  unset ARNOLD_RUNTIME_MANIFEST ARNOLD_REPAIR_SESSION ARNOLD_BABYSITTER_SESSION
fi
unset WATCHDOG_CALLER_SUPERVISOR_PYTHON_SET WATCHDOG_CALLER_SUPERVISOR_PYTHON
unset WATCHDOG_CALLER_RUNTIME_REQUIRED_SET WATCHDOG_CALLER_RUNTIME_REQUIRED
unset WATCHDOG_CALLER_OBSERVER

WRAPPER_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../../.." && pwd)"
SUPERVISOR_RUNTIME_LIB="$(dirname "${BASH_SOURCE[0]:-$0}")/arnold-supervisor-runtime-lib"
if [[ ! -f "$SUPERVISOR_RUNTIME_LIB" ]]; then
  SUPERVISOR_RUNTIME_LIB="/workspace/arnold/arnold_pipelines/megaplan/cloud/wrappers/arnold-supervisor-runtime-lib"
fi
# The wrapper snapshots itself to a temp file (mktemp /tmp/arnold-watchdog.XXX)
# before exec, so BASH_SOURCE points at /tmp and the lib is not beside it.
# Resolve the lib from the MANIFEST-bound runtime root before falling back to
# the shared /usr/local/bin copy — the shared copy is a bootstrapped snapshot
# and drifts stale (missing arnold_runtime_manifest_epic_field), which made the
# relaunch preflight fail closed with "chain_runtime_binding_drift" on every
# scan. Parsing the manifest here needs no lib: it is a plain JSON field read.
if [[ ! -f "$SUPERVISOR_RUNTIME_LIB" && -n "${ARNOLD_RUNTIME_MANIFEST:-}" ]]; then
  _manifest_runtime_root="$(python3 - "$ARNOLD_RUNTIME_MANIFEST" <<'PY' 2>/dev/null || true
import json, pathlib, sys
try:
    payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
    print((payload.get("epic") or {}).get("runtime_root") or "")
except Exception:
    pass
PY
)"
  if [[ -n "$_manifest_runtime_root" && -d "$_manifest_runtime_root" ]]; then
    _manifest_lib="$_manifest_runtime_root/arnold_pipelines/megaplan/cloud/wrappers/arnold-supervisor-runtime-lib"
    if [[ -f "$_manifest_lib" ]]; then
      SUPERVISOR_RUNTIME_LIB="$_manifest_lib"
    fi
  fi
  unset _manifest_runtime_root _manifest_lib
fi
if [[ ! -f "$SUPERVISOR_RUNTIME_LIB" ]]; then
  SUPERVISOR_RUNTIME_LIB="/usr/local/bin/arnold-supervisor-runtime-lib"
fi
# shellcheck disable=SC1090
. "$SUPERVISOR_RUNTIME_LIB"
# Bootstrap the supervisor against the MANIFEST-bound runtime when one is
# declared (ARNOLD_RUNTIME_MANIFEST env or the default marker-adjacent
# manifest). The fixed /workspace/arnold default is only a fallback for
# environments without a per-epic manifest — a live epic must import its
# own fixer-lineage engine, never the shared resident tree, or the
# readiness probe binds the WRONG code (watchdog bootstrap regression).
_BOOTSTRAP_SOURCE_ROOT="/workspace/arnold"
if [[ -n "${ARNOLD_RUNTIME_MANIFEST:-}" ]]; then
  _manifest_root="$(arnold_runtime_manifest_epic_field epic.runtime_root 2>/dev/null || true)"
  if [[ -n "$_manifest_root" && -d "$_manifest_root" ]]; then
    _BOOTSTRAP_SOURCE_ROOT="$_manifest_root"
  fi
fi
arnold_supervisor_runtime_init watchdog "$_BOOTSTRAP_SOURCE_ROOT" || exit $?
# No global manifest or ambient NBF context is authority for a target.  Each
# mutation path binds the exact session marker immediately before its ladder.
export MEGAPLAN_NBF_CONTEXT_BOUND=0

SELF_PATH="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  SELF_PATH="$(readlink -f "$SELF_PATH" 2>/dev/null || printf '%s' "$SELF_PATH")"
fi
WATCHDOG_ARGS=("$@")
WATCHDOG_STARTED_AT="$(date +%s)"
LOCK_FILE="${CLOUD_WATCHDOG_LOCK_FILE:-/workspace/.megaplan/watchdog.lock}"
LOCK_HELD="${CLOUD_WATCHDOG_LOCK_HELD:-0}"
COOPERATIVE_ONCE=0
if [[ "${1:-}" == "--audit-sweep" ]]; then
  # The daemon intentionally owns LOCK_FILE for its whole lifetime.  A six-hour
  # audit sweep therefore bypasses only that lifetime lock and serializes on the
  # per-scan lock acquired by scan_once below.
  COOPERATIVE_ONCE=1
fi
if [[ "$LOCK_HELD" != "1" && "$COOPERATIVE_ONCE" != "1" ]] && command -v flock >/dev/null 2>&1; then
  mkdir -p "$(dirname "$LOCK_FILE")"
  # Legacy lock shape kept visible for wrapper compatibility tests:
  # exec flock -n "$LOCK_FILE" bash "$SELF_PATH" "${WATCHDOG_ARGS[@]}"
  python3 - "$LOCK_FILE" "$SELF_PATH" "${WATCHDOG_ARGS[@]}" <<'PY'
import fcntl
import os
import subprocess
import sys

lock_file = sys.argv[1]
self_path = sys.argv[2]
watchdog_args = sys.argv[3:]

fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o644)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(1)

env = os.environ.copy()
env["CLOUD_WATCHDOG_LOCK_HELD"] = "1"
proc = subprocess.Popen(
    ["bash", self_path, *watchdog_args],
    env=env,
    close_fds=True,
)
raise SystemExit(proc.wait())
PY
  exit $?
fi

LOG="${CLOUD_WATCHDOG_LOG:-/workspace/watchdog.log}"
REPORT_PATH="${CLOUD_WATCHDOG_REPORT_PATH:-/workspace/watchdog-report.json}"
REPORT_ARCHIVE_DIR="${CLOUD_WATCHDOG_REPORT_ARCHIVE_DIR:-/workspace/watchdog-reports}"
REPORT_WEBHOOK="${CLOUD_WATCHDOG_REPORT_WEBHOOK:-}"
INTERVAL="${CLOUD_WATCHDOG_INTERVAL_SECS:-3600}"
MARKER_DIR="${CLOUD_WATCHDOG_MARKER_DIR:-/workspace/.megaplan/cloud-sessions}"
SCAN_LOCK_FILE="${CLOUD_WATCHDOG_SCAN_LOCK_FILE:-/workspace/.megaplan/watchdog-scan.lock}"
SCAN_LOCK_WAIT_SECS="${CLOUD_WATCHDOG_SCAN_LOCK_WAIT_SECS:-600}"
REPAIR_DATA_DIR="${CLOUD_WATCHDOG_REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}"
STATUS_DIR="${CLOUD_WATCHDOG_STATUS_DIR:-/workspace/.megaplan/status}"
REPAIR_ENABLED="${ARNOLD_REPAIR_TRIGGER_ENABLED:-1}"
CODEX_REPAIR_MODEL="${CLOUD_WATCHDOG_CODEX_REPAIR_MODEL:-gpt-5.6-sol}"
PUSH_REPAIRS="${CLOUD_WATCHDOG_PUSH_REPAIRS:-0}"
CODEX_TIMEOUT="${CLOUD_WATCHDOG_CODEX_TIMEOUT_SECS:-7200}"
REAP_AGE_SECS="${CLOUD_WATCHDOG_REAP_AGE_SECS:-7200}"
REAP_ORPHAN_AGE_SECS="${CLOUD_WATCHDOG_REAP_ORPHAN_AGE_SECS:-3900}"
REAP_STALL_GRACE_SECS="${CLOUD_WATCHDOG_REAP_STALL_GRACE_SECS:-1800}"
REAP_STALL_IDLE_SECS="${CLOUD_WATCHDOG_REAP_STALL_IDLE_SECS:-1800}"
REPAIR_DATA_RETENTION_INTERVAL_SECS="${CLOUD_WATCHDOG_REPAIR_DATA_RETENTION_INTERVAL_SECS:-21600}"
ENV_GONE_STRIKES="${CLOUD_WATCHDOG_ENV_GONE_STRIKES:-3}"
SYNC_ENABLED="${CLOUD_WATCHDOG_SYNC_ENABLED:-1}"
SYNC_REPO="${CLOUD_WATCHDOG_SYNC_REPO:-${MEGAPLAN_REPO:-}}"
# SRC_DIR and SYNC_BRANCH resolve below, after the manifest authority gate and
# the manifest field reads: SRC_DIR = manifest epic.runtime_root (fixed
# /workspace/arnold fallback) and SYNC_BRANCH = manifest epic.branch only — no
# env-selector fallback (P4 config cleanup).
# Bounded timeouts so a hung git sync / pip refresh can't freeze a sweep before
# the snapshot is written (watchdog-snapshot-staleness-fix.md P2). Do NOT reuse
# CODEX_TIMEOUT (7200s) for these network/install steps.
SYNC_TIMEOUT_SECS="${CLOUD_WATCHDOG_SYNC_TIMEOUT_SECS:-120}"
INSTALL_REFRESH_TIMEOUT_SECS="${CLOUD_WATCHDOG_INSTALL_REFRESH_TIMEOUT_SECS:-300}"
# Consecutive snapshot-write failures before we drop a visible write-error sidecar.
SNAPSHOT_FAILURE_THRESHOLD="${CLOUD_WATCHDOG_SNAPSHOT_FAILURE_THRESHOLD:-3}"
EXTRA_SKILLS_DIR="${CLOUD_WATCHDOG_EXTRA_SKILLS_DIR:-/workspace/cloud-skills}"
KIMI_OPERATOR_ROOT="${KIMI_GOAL_OPERATOR_ROOT:-/workspace/kimi-goal-operator}"
REPAIR_OPERATOR_ROOT="${CLOUD_WATCHDOG_REPAIR_ROOT:-$KIMI_OPERATOR_ROOT}"
# P1 admission authority: the shared lib gate is the SOLE per-epic
# manifest resolver. Observer mode is marker-scoped: it MUST NOT bind a
# box-global ARNOLD_RUNTIME_MANIFEST (that is the /tmp pin class). Per-tick
# identity is the marker session -> {manifest_dir}/{session}.json.
if [[ "${ARNOLD_WATCHDOG_OBSERVER:-}" == "1" ]]; then
  MANIFEST_RUNTIME_ROOT=""
  MANIFEST_EPIC_BRANCH=""
  # The snapshot lives under /tmp; origin is the tracked wrapper. Four
  # parents up from cloud/wrappers/arnold-watchdog is the engine root.
  if [[ -n "${ARNOLD_WATCHDOG_ORIGIN:-}" ]]; then
    SRC_DIR="$(cd "$(dirname "$ARNOLD_WATCHDOG_ORIGIN")/../../../.." && pwd)"
  else
    SRC_DIR="${WRAPPER_REPO_ROOT:-/workspace/arnold}"
  fi
  SYNC_BRANCH=""
else
  arnold_runtime_manifest_authority watchdog
  MANIFEST_RUNTIME_ROOT="$(arnold_runtime_manifest_epic_field epic.runtime_root)"
  MANIFEST_EPIC_BRANCH="$(arnold_runtime_manifest_epic_field epic.branch)"
  # Runtime source + sync branch resolve from the per-epic manifest ONLY: the
  # manifest runtime_root, else the fixed /workspace/arnold fallback for
  # permit-admitted manifest-less runtimes.  Hot env and the legacy selectors
  # can never re-point a supervisor (P4 config cleanup).
  SRC_DIR="${MANIFEST_RUNTIME_ROOT:-/workspace/arnold}"
  SYNC_BRANCH="${MANIFEST_EPIC_BRANCH:-}"
fi
# G5 (round-17 finding 1c): the live root the engine-root preflight compares
# against is the ACTUAL import root of this running python — the root the
# process resolves ``arnold_pipelines`` from — NOT the manifest-derived
# SRC_DIR (a manifest==SRC_DIR comparison can never fail: tautological).  A
# watchdog that cannot import its own package cannot prove a relaunch
# runtime binding; an unavailable live root fails closed (typed drift, exit
# 24) at the preflight.
LIVE_IMPORT_ROOT="$(python3 - <<'PY' 2>/dev/null || true
import importlib.util
import pathlib

spec = importlib.util.find_spec("arnold_pipelines")
if spec is None or spec.origin is None:
    raise SystemExit(1)
print(pathlib.Path(spec.origin).resolve().parent.parent)
PY
)"
# Dispatch runtime source: the babysitter child executes AND imports its code
# from the SAME runtime as the watchdog (the manifest runtime_root, else
# SRC_DIR), so the selected executable and PYTHONPATH never diverge. The
# layered L1/L2/repair-trigger bin resolution was removed with the layered
# repair stack; launch_status_trigger_babysitter resolves its own bin and
# goal renderer from the live engine roots.
REPAIR_DISPATCH_RUNTIME_SRC="$SRC_DIR"
if [[ -n "$MANIFEST_RUNTIME_ROOT" ]]; then
  REPAIR_DISPATCH_RUNTIME_SRC="$MANIFEST_RUNTIME_ROOT"
fi
DISCOVER_BIN="${CLOUD_WATCHDOG_DISCOVER_BIN:-$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/arnold-cloud-discover}"
ONCE="${1:-}"
if [[ "$COOPERATIVE_ONCE" == "1" ]]; then
  ONCE="--once"
fi
REPAIR_DISPATCH_RESULT=
REPAIR_DISPATCH_RUN_ID=
REPAIR_DISPATCH_MANIFEST=

mkdir -p "$(dirname "$LOG")"

log() {
  local message
  message="$(redact_inline_text "$*")"
  echo "[watchdog $(date -Iseconds)] $message" | tee -a "$LOG"
}

authority_gap_record() {
  local evidence_id="$1"
  local disposition="$2"
  local rc="$3"
  local detail="${4:-authority-risk bypass converted to typed evidence gap}"
  local gap_root="${REPAIR_DATA_DIR:-${DATA_DIR:-${MARKER_DIR:-/tmp}}}"
  local gap_path="$gap_root/authority-gaps.jsonl"
  local log_path="${LOG:-/dev/null}"
  mkdir -p "$gap_root" >/dev/null 2>&1 || true
  python3 - "$gap_path" "$evidence_id" "$disposition" "$rc" "$detail" \
    "${session:-${SESSION:-}}" "${workspace:-${WORKSPACE:-}}" "${remote_spec:-${REMOTE_SPEC:-}}" <<'PY' \
    >/dev/null 2>>"$log_path" || true
import datetime as dt
import json
import pathlib
import sys

path, evidence_id, disposition, rc, detail, session, workspace, remote_spec = sys.argv[1:9]
payload = {
    "schema_version": "arnold.megaplan.cloud.wrapper_authority_gap.v1",
    "evidence_id": evidence_id,
    "disposition": disposition,
    "exit_code": int(rc) if str(rc).isdigit() else rc,
    "detail": detail,
    "wrapper": "arnold-watchdog",
    "session": session,
    "workspace": workspace,
    "remote_spec": remote_spec,
    "recorded_at": dt.datetime.now(dt.timezone.utc).isoformat(),
}
target = pathlib.Path(path)
target.parent.mkdir(parents=True, exist_ok=True)
with target.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(payload, sort_keys=True) + "\n")
PY
  printf '[watchdog %s] authority gap %s disposition=%s rc=%s path=%s\n' \
    "$(date -Iseconds)" "$evidence_id" "$disposition" "$rc" "$gap_path" >>"$log_path" 2>&1 || true
}

authority_gap_continue() {
  local rc=$?
  authority_gap_record "$1" "typed_evidence_gap" "$rc" "${2:-authority-risk bypass converted to typed evidence gap}"
  return 0
}

authority_fail_closed() {
  local rc=$?
  authority_gap_record "$1" "fail_closed" "$rc" "${2:-authority-risk bypass failed closed}"
  return 1
}

redact_inline_text() {
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$1" <<'PY'
import sys

from arnold_pipelines.megaplan.cloud.redact import redact_text

print(redact_text(sys.argv[1]), end="")
PY
}

redact_file_in_place() {
  local path="${1:-}"
  if [[ -z "$path" || ! -f "$path" ]]; then
    return 0
  fi
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$path" <<'PY'
from pathlib import Path
import sys

from arnold_pipelines.megaplan.cloud.redact import redact_text

path = Path(sys.argv[1])
path.write_text(redact_text(path.read_text(encoding="utf-8")), encoding="utf-8")
PY
}

maybe_reexec_updated_watchdog() {
  local wrapper_path wrapper_mtime
  local source_wrapper source_mtime
  local reexec_path reexec_reason

  wrapper_path="$SELF_PATH"
  wrapper_mtime="$(stat -c %Y "$wrapper_path" 2>/dev/null || stat -f %m "$wrapper_path" 2>/dev/null || echo 0)"
  [[ "$wrapper_mtime" =~ ^[0-9]+$ ]] || wrapper_mtime=0

  source_wrapper="$SRC_DIR/arnold_pipelines/megaplan/cloud/wrappers/$(basename "$SELF_PATH")"
  source_mtime=0
  if [[ -f "$source_wrapper" ]]; then
    source_mtime="$(stat -c %Y "$source_wrapper" 2>/dev/null || stat -f %m "$source_wrapper" 2>/dev/null || echo 0)"
    [[ "$source_mtime" =~ ^[0-9]+$ ]] || source_mtime=0
  fi

  reexec_path=""
  reexec_reason=""
  if (( source_mtime > WATCHDOG_STARTED_AT && source_mtime >= wrapper_mtime )); then
    reexec_path="$source_wrapper"
    reexec_reason="editable source wrapper"
  elif (( wrapper_mtime > WATCHDOG_STARTED_AT )); then
    reexec_path="$wrapper_path"
    reexec_reason="current script"
  fi

  if [[ -n "$reexec_path" ]]; then
    log "watchdog wrapper updated on disk; re-execing $reexec_reason"
    if [[ -n "${scan_lock_fd:-}" ]]; then
      flock -u "$scan_lock_fd" 2>/dev/null || true
      exec {scan_lock_fd}>&-
    fi
    exec bash "$reexec_path" "${WATCHDOG_ARGS[@]}"
  fi
}

