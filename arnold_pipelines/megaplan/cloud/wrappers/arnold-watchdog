# ── P2 typed runtime transitions ──────────────────────────────────────────
# One typed deviation/fallback event path.  Every runtime deviation and
# fallback decision is appended to the incident ledger BEFORE the caller
# performs a dispatch side effect.  The append is synchronous and never
# swallowed: a non-zero CLI exit (policy rejection or journal write failure)
# returns 1 and the caller MUST block dispatch (no event = no side effect).
# Emitting is a pure append-only ledger write — it never dispatches repair
# and never triggers a scan (mirror of emit_watchdog_incident_bridge_event).
# Missing inputs (no workspace, no spec, unreadable spec) FAIL CLOSED: the
# event cannot be durably recorded without a contract digest, so the caller
# MUST treat a non-zero return as "do not dispatch" — never succeed
# eventless.
emit_runtime_transition_event() {
  local event_name="$1"
  local session="$2"
  local workspace="$3"
  local remote_spec="$4"
  local failure_class="${5:-}"
  local error_text="${6:-}"
  local candidate_to="${7:-}"
  local candidate_from="${8:-}"
  local attempt_num="${9:-}"
  local summary_text="${10:-}"
  local chain_digest ledger_rc
  local -a ledger_args
  if [[ -z "$workspace" || -z "$remote_spec" || ! -f "$remote_spec" ]]; then
    printf '[watchdog %s] runtime transition ledger input missing (workspace/spec) for %s; blocking dispatch session=%s\n' \
      "$(date -Iseconds)" "$event_name" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
    return 1
  fi
  chain_digest="$(PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$remote_spec" <<'PY'
import pathlib
import sys

from arnold_pipelines.megaplan.chain.spec import chain_spec_sha256

print(chain_spec_sha256(pathlib.Path(sys.argv[1])))
PY
)"
  if [[ -z "$chain_digest" ]]; then
    return 1
  fi
  ledger_args=(
    "$event_name"
    --root "$workspace"
    --scope "chain:$session"
    --session-id "$session"
    --actor "arnold-watchdog"
    --failure-class "$failure_class"
    --error "$error_text"
    --candidate-to "$candidate_to"
    --candidate-from "$candidate_from"
    --attempt "$attempt_num"
    --chain-spec-sha256 "$chain_digest"
  )
  if [[ -n "$summary_text" ]]; then
    ledger_args+=(--summary "$summary_text")
  fi
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 -W ignore::RuntimeWarning \
    -m arnold_pipelines.megaplan.incident.ledger "${ledger_args[@]}" \
    >> "${LOG:-/dev/null}" 2>&1
  ledger_rc=$?
  if [[ "$ledger_rc" != "0" ]]; then
    printf '[watchdog %s] runtime transition ledger write failed (%s) rc=%s; blocking dispatch session=%s\n' \
      "$(date -Iseconds)" "$event_name" "$ledger_rc" "$session" >>"${LOG:-/dev/null}" 2>&1 || true
    return 1
  fi
  return 0
}

# ---- meta-repair dispatch ----------------------------------------------------
# Meta-repair diagnoses and fixes repair-system failures when ordinary repair
# has proven insufficient.  It is gated behind META_REPAIR_ENABLED (default-on),
# guarded against recursion, and tracked with dedicated marker/pgid sidecars so
# the watchdog can observe its lifecycle independently of ordinary repair.

run_repair_data_maintenance() {
  local throttle_secs="${REPAIR_DATA_RETENTION_INTERVAL_SECS:-21600}"
  [[ "$throttle_secs" =~ ^[0-9]+$ ]] || throttle_secs=21600
  if (( throttle_secs <= 0 )); then
    return 0
  fi

  PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$MARKER_DIR" "$REPAIR_DATA_DIR" "$throttle_secs" <<'PY'
import json
import pathlib
import sys
from datetime import datetime, timezone

from arnold_pipelines.megaplan.cloud.repair_contract import cleanup_repair_data_retention, load_json
from arnold_pipelines.megaplan.cloud.repair_lock import inspect_repair_lock
from arnold_pipelines.megaplan.cloud.session_markers import is_canonical_session_marker_path

marker_dir = pathlib.Path(sys.argv[1])
repair_data_dir = pathlib.Path(sys.argv[2])
throttle_secs = int(sys.argv[3])
sidecar_dir = repair_data_dir.with_name(f"{repair_data_dir.name}.d")
stamp_path = sidecar_dir / "cleanup" / "retention-maintenance.json"
now = datetime.now(timezone.utc)

previous = load_json(stamp_path, default={})
last_started_at = str(previous.get("started_at") or "").strip() if isinstance(previous, dict) else ""
if last_started_at:
    try:
        started_at = datetime.fromisoformat(last_started_at)
    except ValueError:
        started_at = None
    if started_at is not None and (now - started_at).total_seconds() < throttle_secs:
        print("THROTTLED")
        raise SystemExit(0)

for lock_dir in sorted(marker_dir.glob("*.repair-loop.lock")):
    result = inspect_repair_lock(lock_dir)
    if result.busy:
        print("LOCK_BUSY")
        raise SystemExit(0)

active_sessions: set[str] = set()
for path in sorted(marker_dir.glob("*.json")):
    if not is_canonical_session_marker_path(path):
        continue
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    if isinstance(payload, dict):
        session = str(payload.get("session") or "").strip()
        if session:
            active_sessions.add(session)

stamp_path.parent.mkdir(parents=True, exist_ok=True)
stamp_path.write_text(json.dumps({"started_at": now.isoformat()}, sort_keys=True), encoding="utf-8")
summary = cleanup_repair_data_retention(
    repair_data_dir,
    sidecar_dir=sidecar_dir,
    index_path=repair_data_dir / "index.json",
    now=now,
    active_session_ids=active_sessions,
)
stamp_path.write_text(
    json.dumps(
        {
            "started_at": now.isoformat(),
            "completed_at": datetime.now(timezone.utc).isoformat(),
            "cleanup_id": summary.get("cleanup_id", ""),
        },
        sort_keys=True,
    ),
    encoding="utf-8",
)
print(f"RAN:{summary.get('cleanup_id', '')}")
PY
}

reap_stale_repair_candidates() {
  python3 - "$REAP_AGE_SECS" "$REAP_ORPHAN_AGE_SECS" <<'PY'
import re
import sys

SESSION_RE = re.compile(r"Session:\s+([^\s]+)")
CODEX_RE = re.compile(r"(^|\s)codex exec(\s|$)")
RUN_AGENT_HINTS = (
    "workflows on this Hetzner worker should never pause unexpectedly",
    "cloud watchdog",
    "Kimi launch/diagnosis turn",
)
CODEX_HINTS = (
    "You are the watchdog repair-loop dev-fix agent",
    "bounded 3-iteration repair loop",
    "repair data file",
    "workflows on this Hetzner worker should not pause unexpectedly",
)
PROTECTED_HINTS = (
    "arnold-watchdog",
    "arnold-progress-auditor",
)
RULE_PRIORITY = {
    "orphan_fast_path": 0,
    "age_backstop": 1,
}
KIND_PRIORITY = {
    "arnold.agent.run_agent": 0,
    "codex exec": 1,
}


def parse_ps_row(raw: str):
    parts = raw.strip().split(None, 4)
    if len(parts) < 5:
        return None
    try:
        return {
            "pid": int(parts[0]),
            "ppid": int(parts[1]),
            "pgid": int(parts[2]),
            "etimes": int(parts[3]),
            "args": parts[4],
        }
    except ValueError:
        return None


def extract_session(kind: str, args: str) -> str:
    match = SESSION_RE.search(args)
    return match.group(1) if match else ""


def classify_kind(args: str) -> str:
    if any(hint in args for hint in PROTECTED_HINTS):
        return ""
    if "arnold.agent.run_agent" in args:
        session = extract_session("arnold.agent.run_agent", args)
        if session and any(hint in args for hint in RUN_AGENT_HINTS):
            return "arnold.agent.run_agent"
    if CODEX_RE.search(args):
        session = extract_session("codex exec", args)
        if session and any(hint in args for hint in CODEX_HINTS):
            return "codex exec"
    return ""


def decide_reap(row: dict[str, object], age_secs: int, orphan_age_secs: int) -> dict[str, object]:
    args = str(row.get("args") or "")
    kind = classify_kind(args)
    session = extract_session(kind, args) if kind else ""
    decision = {
        "pid": int(row.get("pid") or 0),
        "ppid": int(row.get("ppid") or 0),
        "pgid": int(row.get("pgid") or 0),
        "etimes": int(row.get("etimes") or 0),
        "kind": kind,
        "session": session,
        "reap": False,
        "rule": "",
        "reason": "non_target" if not kind else "under_age",
    }
    if not kind:
        return decision
    if (
        kind in {"arnold.agent.run_agent", "codex exec"}
        and decision["ppid"] == 1
        and decision["etimes"] > orphan_age_secs
    ):
        decision["reap"] = True
        decision["rule"] = "orphan_fast_path"
        decision["reason"] = "orphaned_ppid_1"
        return decision
    if decision["etimes"] > age_secs:
        decision["reap"] = True
        decision["rule"] = "age_backstop"
        decision["reason"] = "elapsed_exceeded"
    return decision


def choose_reap_candidates(rows: list[dict[str, object]], age_secs: int, orphan_age_secs: int):
    candidates = [
        decide_reap(row, age_secs, orphan_age_secs)
        for row in rows
    ]
    candidates = [item for item in candidates if item["reap"]]
    candidates.sort(
        key=lambda item: (
            item["session"] or "",
            item["pgid"],
            RULE_PRIORITY[item["rule"]],
            KIND_PRIORITY[item["kind"]],
            -item["etimes"],
            item["pid"],
        )
    )
    seen_sessions = set()
    seen_pgids = set()
    selected = []
    for item in candidates:
        session = item["session"]
        pgid = item["pgid"]
        if session and session in seen_sessions:
            continue
        if pgid in seen_pgids:
            continue
        selected.append(item)
        if session:
            seen_sessions.add(session)
        seen_pgids.add(pgid)
    return selected


def main() -> int:
    age_secs = int(sys.argv[1])
    orphan_age_secs = int(sys.argv[2])
    rows = []
    for raw in sys.stdin:
        row = parse_ps_row(raw)
        if row:
            rows.append(row)
    for item in choose_reap_candidates(rows, age_secs, orphan_age_secs):
        print(
            "\t".join(
                [
                    str(item["pid"]),
                    str(item["ppid"]),
                    str(item["pgid"]),
                    str(item["etimes"]),
                    str(item["kind"]),
                    str(item["session"]),
                    str(item["rule"]),
                    str(item["reason"]),
                ]
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PY
}

reap_stalled_repair_candidates() {
