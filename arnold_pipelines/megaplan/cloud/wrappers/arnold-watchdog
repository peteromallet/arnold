    values = {
        key: str(marker.get(key) or "").strip()
        for key in ("bootstrap_manifest_path", "manifest_sha256", "manifest_identity")
    }
    # Older observational markers may retain only the manifest path.  They
    # remain spawnable for compatibility, but the child receives the marker
    # path and its admission gate fails closed until the digest pair exists.
    if not values["manifest_sha256"] and not values["manifest_identity"]:
        return None
    if not all(values.values()):
        raise RuntimeError("session marker manifest identity is incomplete")
    manifest_path = Path(values["bootstrap_manifest_path"])
    try:
        from arnold_pipelines.megaplan.cloud.runtime_manifest import (
            manifest_bytes_sha256,
