write_watchdog_observation_error() {
  local reason="$1"
  local status_dir="${2:-$STATUS_DIR}"
  local stamp tmp target
  mkdir -p "$status_dir" 2>/dev/null || return 1
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  target="$status_dir/watchdog-observation-failure.json"
  tmp="$(mktemp "$status_dir/.watchdog-observation-failure.XXXXXX")" || return 1
  printf '{"at":"%s","error":"watchdog observation bootstrap failed; watchdog report may be stale","reason":"observation_runtime_not_ready","schema_version":"arnold-watchdog-observation-failure-v1","status":"failed"}\n' \
    "$stamp" > "$tmp"
  mv -f "$tmp" "$target"
  # Preserve the legacy consumer path with the same atomic payload.
  tmp="$(mktemp "$status_dir/.cloud-status.write-error.XXXXXX")" || return 1
