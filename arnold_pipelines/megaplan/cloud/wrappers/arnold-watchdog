session_health_status() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local wait_status
  if ! arnold_supervisor_tmux_session_exists "$session"; then
    if matching_runner_process_alive "$workspace" "$remote_spec" "$run_kind" "$plan_name"; then
      echo "alive"
      return 0
    fi
    if [[ "$run_kind" == "chain" ]]; then
      if chain_process_is_alive "$remote_spec" || plan_process_is_alive "$plan_name"; then
        echo "alive"
        return 0
      fi
      wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
      if [[ "$wait_status" != "none" ]]; then
        echo "$wait_status"
        return 0
      fi
    elif [[ "$run_kind" == "epic_chain" ]]; then
      if epic_chain_process_is_alive "$remote_spec"; then
        echo "alive"
        return 0
      fi
    elif [[ -n "$plan_name" ]] && plan_process_is_alive "$plan_name"; then
      echo "alive"
      return 0
    fi
    echo "stopped"
    return 0
  fi

  local pane log_path
  capture_socket="$(arnold_supervisor_tmux_session_socket "$session" 2>/dev/null || true)"
  pane="$(tmux -S "$capture_socket" capture-pane -pt "$session" -S -120 2>/dev/null || true)"
  if printf '%s\n' "$pane" | grep -Eq 'cmd exited rc=[1-9]|error retry [0-9]+/[0-9]+'; then
    echo "retrying_failure"
    return 0
  fi

  if [[ "$run_kind" == "chain" ]]; then
    if [[ "$session" == "megaplan-chain" ]]; then
      log_path="$workspace/.megaplan/cloud-chain.log"
    else
      log_path="$workspace/.megaplan/cloud-chain-${session}.log"
    fi
    if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
      echo "chain_log_failure"
      return 0
    fi

    if chain_process_is_alive "$remote_spec"; then
      echo "alive"
      return 0
    fi

    wait_status="$(chain_wait_status "$workspace" "$remote_spec")"
    if [[ "$wait_status" != "none" ]]; then
      echo "$wait_status"
      return 0
    fi
  elif [[ "$run_kind" == "epic_chain" ]]; then
    log_path="$workspace/.megaplan/cloud-epic-chain-${session}.log"
    if [[ -f "$log_path" ]] && tail -80 "$log_path" 2>/dev/null | grep -Eq '"error": "invalid_spec"|invalid_spec|"error": "git_refresh_failed"|git_refresh_failed|fatal: couldn'\''t find remote ref'; then
      echo "chain_log_failure"
      return 0
    fi

    if epic_chain_process_is_alive "$remote_spec"; then
      echo "alive"
      return 0
    fi
  elif [[ -n "$plan_name" ]]; then
    if plan_process_is_alive "$plan_name"; then
      echo "alive"
      return 0
    fi
  fi

  echo "stopped"
}

verify_relaunch_health() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local attempts="${6:-15}"
  local health="stopped"
  local attempt
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    health="$(session_health_status "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name")"
    case "$health" in
      alive|awaiting_pr_merge)
        printf '%s\n' "$health"
        return 0
        ;;
      chain_log_failure|retrying_failure)
        printf '%s\n' "$health"
        return 1
        ;;
    esac
    sleep 1
  done
  printf '%s\n' "$health"
  return 1
}

kimi_operator_running() {
  local session="$1"
  local pgid_path pgid
  # The layered L1 repair-loop / kimi-goal-operator process scans were removed
  # with the layered repair stack. The pgid marker (legacy dispatch custody)
  # remains the liveness source for the Stage-0 marker state machine: any
  # process group still alive under a recorded dispatch pgid counts as
  # running.
  pgid_path="$(kimi_pgid_path "$session")"
  [[ -r "$pgid_path" ]] || return 1
  read -r pgid < "$pgid_path" || return 1
  [[ "$pgid" =~ ^[0-9]+$ ]] || return 1
  if kill -0 "$pgid" >/dev/null 2>&1; then
    return 0
  fi
  kill -0 -- "-$pgid" >/dev/null 2>&1 || return 1
  if ps -eo pgid= 2>/dev/null \
    | awk -v target="$pgid" '$1 == target { found=1 } END { exit found ? 0 : 1 }'; then
    return 0
  fi
  return 1
}

# Per-session repair-cycle marker. The watchdog sets it when a stopped session
# gets a mechanical relaunch; if the session re-stops before becoming healthy,
# the next tick escalates to the primary repair operator. The historical
