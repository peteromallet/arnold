write_partial_liveness_tick() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local health="${6:-alive}"
  local sidecar_dir events_path
  sidecar_dir="${CLOUD_WATCHDOG_REPAIR_SIDECAR_DIR:-${REPAIR_DATA_DIR}.d}"
  events_path="$sidecar_dir/events/events.jsonl"
  mkdir -p "$(dirname "$events_path")" 2>/dev/null || true
  PYTHONPATH="$WRAPPER_REPO_ROOT:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$events_path" "$session" "$health" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

events_path, session, health, workspace, remote_spec, run_kind, plan_name = sys.argv[1:8]

MAX_TICKS = 20

tick = {
    "session": session,
    "outcome": "partial_liveness",
    "health": health,
    "recorded_at": datetime.now(timezone.utc).isoformat(),
    "run_kind": run_kind,
    "plan_name": plan_name,
}

# Read existing events, append the new tick, and truncate to MAX_TICKS
events = []
try:
    if os.path.exists(events_path):
        with open(events_path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    events.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
except Exception:
    pass

events.append(tick)

# Keep only the most recent MAX_TICKS
if len(events) > MAX_TICKS:
    events = events[-MAX_TICKS:]

# Write atomically via temp file
tmp_path = events_path + ".tmp"
try:
    with open(tmp_path, "w", encoding="utf-8") as fh:
        for entry in events:
            fh.write(json.dumps(entry, sort_keys=True) + "\n")
    os.replace(tmp_path, events_path)
except Exception:
    pass
PY
}

env_gone_sidecar_path() {
  printf '%s/%s.env-gone' "$MARKER_DIR" "$(safe_name "$1")"
}

# Detect whether a session's environment has been wiped (workspace dir or
# chain/epic-chain spec gone — typically after a box reset/redeploy). Uses a
# strike counter so a transient deploy gap doesn't retire a live session.
#
#stdout: prints one of:
#   - "gone"    and exits 0  -> env missing AND strikes >= $ENV_GONE_STRIKES
#   - "<count>" and exits 1  -> env missing, strikes below threshold (count printed)
#   - "present" and exits 1  -> env present (any prior sidecar cleared; recovers
#                              from a transient deploy that has since resolved)
environment_gone_check() {
  local session="$1"
  local workspace="$2"
  local spec_path="${3:-}"
  local sidecar count
  sidecar="$(env_gone_sidecar_path "$session")"

  # Env present: clear any stale strike sidecar and signal fall-through.
  if [[ -d "$workspace" ]] && { [[ -z "$spec_path" ]] || [[ -f "$spec_path" ]]; }; then
    if [[ -f "$sidecar" ]]; then
      rm -f "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-151" "authority-risk bypass converted to typed evidence gap"
      log "env-gone strikes cleared; environment recovered session=$session workspace=$workspace spec=${spec_path:-}"
    fi
    printf 'present\n'
    return 1
  fi

  count=0
  if [[ -f "$sidecar" ]]; then
    count="$(cat "$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-152" "authority-risk bypass converted to typed evidence gap")"
    count="${count//[!0-9]/}"
    count="${count:-0}"
  fi
  count=$((count + 1))
  printf '%s\n' "$count" >"$sidecar" 2>/dev/null || authority_gap_continue "T29-BYPASS-153" "authority-risk bypass converted to typed evidence gap"

  if (( count >= ENV_GONE_STRIKES )); then
    printf 'gone\n'
    return 0
  fi
  printf '%s\n' "$count"
  return 1
}

# Persist an environment_gone terminal outcome to repair-data for audit.
# Writes via save_repair_data directly (NOT repair_data_set_outcome, which
# requires the repair lock the watchdog does not hold). Best-effort: a failed
# write must not block session retirement.
persist_environment_gone_outcome() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  local data_file="${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}/${session}.repair-data.json"
  PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$data_file" "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY' 2>>"${LOG:-/dev/null}" || authority_gap_continue "T29-BYPASS-154" "authority-risk bypass converted to typed evidence gap"
import pathlib
import sys

from arnold_pipelines.megaplan.cloud.repair_contract import (
    ENVIRONMENT_GONE,
    load_json,
    save_repair_data,
)

data_path_raw, session, workspace, remote_spec, run_kind, plan_name = sys.argv[1:]
data_path = pathlib.Path(data_path_raw)
payload = load_json(data_path, default={})
if not isinstance(payload, dict):
    payload = {}
payload.setdefault("session", session)
payload.setdefault("workspace", workspace)
payload.setdefault("run_kind", run_kind)
payload.setdefault("plan_name", plan_name)
payload["workspace"] = workspace
payload["run_kind"] = run_kind
