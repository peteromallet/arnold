    return False


def _write_cleanup_hold(session, digest, run_root, payload, reason):
    """Persist an unresolved wedge so the caller cannot redispatch.

    This observer has no marker-bound authority and therefore must not signal.
    The later canonical reaper can bind the session marker and perform the
    validated ladder.
    """
    hold_root = run_root if run_root is not None and run_root.is_dir() else repair_data
    hold_path = hold_root / "cleanup-hold.json"
    hold = {
        "kind": "cleanup_hold",
        "status": "unresolved",
        "reason": reason,
        "session": session,
        "occurrence_digest": digest,
        "run_root": str(run_root) if run_root is not None else "",
        "babysitter_pid": payload.get("babysitter_pid"),
        "supervisor_pid": payload.get("supervisor_pid"),
        "reconciliation": "canonical_reaper_after_marker_binding",
        "created_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    try:
        hold_path.parent.mkdir(parents=True, exist_ok=True)
        hold_path.write_text(json.dumps(hold, sort_keys=True) + "\n", encoding="utf-8")
    except OSError as exc:
        print(f"cleanup hold persistence failed: {exc}", file=sys.stderr)
