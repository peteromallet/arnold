def emit_runtime_transition(event_name: str, *, error: str = "", summary: str = "") -> None:
    """Append one typed runtime transition BEFORE a dispatch side effect.

    The ledger append is synchronous and never swallowed.  Fail closed —
    missing workspace/spec (no contract digest) or a ledger write failure
    raises SystemExit(1) so the caller MUST NOT perform the launch side
    effect (no event = no side effect).
