# ─────────────────────────────────────────────────────────────────────────────
# Single-flash babysitter launch machinery (Q1/Q2). The watchdog's ONLY repair
# dispatch is the status-trigger babysitter: one managed
# omp:deepseek/deepseek-v4-flash agent whose goal prompt does
# swarm -> Codex -> implement -> relaunch -> prove. Everything else in the
# repair-dispatch stack (L1 repair-loop, L2 meta-repair, repair-trigger) has
# been removed; there is deliberately NO fallthrough.
# ─────────────────────────────────────────────────────────────────────────────

# Occurrence fingerprint shared by the dedup gate and the launch: sha256 of
# kind/phase/message/phase_or_step/blocked_task_id from the durable plan
# failure state, first 12 hex chars. An empty failure record still produces a
# deterministic digest (all-empty fields) so same-session ticks dedup.
babysitter_occurrence_digest() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
    "$session" "$workspace" "$remote_spec" "$run_kind" "$plan_name" <<'PY'
import hashlib
import json
import pathlib
import sys

session, workspace_raw, remote_spec_raw, run_kind, plan_name = sys.argv[1:]
workspace = pathlib.Path(workspace_raw)
plan_name = str(plan_name or "").strip()
state_path = None
if plan_name:
    candidate = workspace / ".megaplan" / "plans" / plan_name / "state.json"
    if candidate.is_file():
        state_path = candidate
elif run_kind == "plan":
    plans_root = workspace / ".megaplan" / "plans"
    candidates = sorted(
        plans_root.glob("*/state.json"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    if candidates:
        state_path = candidates[0]
else:
    # chain / epic_chain: read the chain state's current plan if resolvable,
    # else fall back to the newest plan state in the workspace.
    chain_path = None
    if remote_spec_raw:
        spec_path = pathlib.Path(remote_spec_raw)
        if not spec_path.is_absolute():
            spec_path = workspace / spec_path
        try:
            spec_resolved = spec_path.resolve()
        except Exception:
            spec_resolved = spec_path
        chain_digest = hashlib.sha1(str(spec_resolved).encode("utf-8")).hexdigest()[:12]
        for candidate in (
            workspace / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
            workspace / ".megaplan" / "plans" / ".chains" / f"{spec_resolved.stem}-{chain_digest}.json",
            spec_resolved.parent / ".megaplan" / "plans" / ".chains" / f"chain-{chain_digest}.json",
        ):
            if candidate.is_file():
                chain_path = candidate
                break
    if chain_path is not None:
        try:
            chain_state = json.loads(chain_path.read_text(encoding="utf-8"))
            chain_plan = str(chain_state.get("current_plan_name") or "").strip()
        except Exception:
            chain_plan = ""
        if chain_plan:
            candidate = workspace / ".megaplan" / "plans" / chain_plan / "state.json"
            if candidate.is_file():
                state_path = candidate
    if state_path is None:
        plans_root = workspace / ".megaplan" / "plans"
        candidates = sorted(
            plans_root.glob("*/state.json"),
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )
        if candidates:
            state_path = candidates[0]


def _load_json(path):
    if path is None:
        return {}
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


latest_failure = _load_json(state_path).get("latest_failure")
latest_failure = latest_failure if isinstance(latest_failure, dict) else {}
metadata = latest_failure.get("metadata")
metadata = metadata if isinstance(metadata, dict) else {}
digest_src = dict(
    kind=str(latest_failure.get("kind") or ""),
    phase=str(latest_failure.get("phase") or ""),
    message=str(latest_failure.get("message") or ""),
    phase_or_step=str(metadata.get("phase_or_step") or ""),
    blocked_task_id=str(metadata.get("blocked_task_id") or ""),
)
if not any(digest_src.values()):
    # The auto-driver clears state.latest_failure when a stall is recorded,
    # so the fields above degenerate to ALL-EMPTY for every stalled chain and
    # the digest collapses to one fixed value (which collided with d587's real
    # digest). Recover durable identity from artifacts the driver does NOT
    # clear: the plan's phase_result (exit kind + phase) plus iteration and
    # current state. Same stall -> same digest; different stall -> different.
    if state_path is not None and state_path.is_file():
        plan_dir = state_path.parent
        phase_result = _load_json(plan_dir / "phase_result.json")
        digest_src["phase_result_phase"] = str(
            phase_result.get("phase") if isinstance(phase_result, dict) else ""
        )
        digest_src["phase_result_exit"] = str(
            phase_result.get("exit_kind") if isinstance(phase_result, dict) else ""
        )
        state_payload = _load_json(state_path)
        digest_src["state"] = str(state_payload.get("current_state") or "")
        digest_src["iteration"] = str(state_payload.get("iteration") or "")
print(hashlib.sha256(json.dumps(digest_src, sort_keys=True).encode("utf-8")).hexdigest()[:12])
PY
}

# driver.babysitter gate: prints "mode\tafter" where mode is superfixer|off and
# after is the ISO-8601 duration ("" when unset). Missing/unparseable spec
# defaults to superfixer with no delay (default ON).
#
# The remote_spec the watchdog carries is the CHAIN spec (chain.yaml). The
# driver.babysitter policy lives on the DEPLOY spec (cloud.yaml) that load_spec
# parses: resolve remote_spec itself first (a deploy spec may be passed
# directly), then the sibling ``cloud.yaml`` / ``<stem>.cloud.yaml`` in the
# same initiative directory (the standard layout).

# babysitter_parked_chain_stall: True when the session's chain is STOPPED in a
# state with NO active step and NO live driver — a milestone plan that was
# born but never driven (initialized / planned / finalized / critiqued /
# gated), OR a plan that STOPPED in a failure state (blocked / failed) with
# no worker live on it. Such a chain is a genuine stoppage the fixer must
# pick up: pre-execute it is a DRIVE, failed it is a REPAIR (the fixer's job
# is to diagnose, fix, ship, rebind, resume). A plan with a live active-step
# worker is NOT parked. mode=off disables REPAIR dispatch, but a parked stall
# is a drive the fixer must still pick up.
#
# Why failed/blocked are included (grok strategy consult 2026-08-16): a
# blocked/failed plan with no live driver and no lease sits behind the
# liveness fence (PID/lease-based, not marker-SHA-based) -> watchdog reports
# 'liveness unavailable; fenced' -> NO babysitter dispatches -> the fixer
# that would rebind the stale marker (consumer lag) never runs -> catch-22,
# chain strands forever. Extending the pre-fence dispatch exception (which
# already exists for parked pre-execute stalls because a parked chain has no
# live driver by definition) to stopped failed plans gives the fixer the
# occurrence. The dispatch is still the single-flash babysitter; mechanical
# relaunch remains fenced; the drive/repair is never --fresh and never wipes.
babysitter_parked_chain_stall() {
  local session="$1"
  local workspace="$2"
  local remote_spec="$3"
  local run_kind="${4:-chain}"
  local plan_name="${5:-}"
  PYTHONPATH="${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - "$session" "$workspace" "$remote_spec" "$plan_name" <<'PY'
import json
import os
import sys
from pathlib import Path


session, workspace_raw, remote_spec_raw, plan_name = sys.argv[1:]
workspace = Path(workspace_raw)

def _pid_alive(value: object) -> bool:
    """Node-level liveness: a leftover active_step.phase is not a live worker."""
    try:
        pid = int(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True

def _find_plan_dir() -> Path | None:
    plans_root = workspace / ".megaplan" / "plans"
    if not plans_root.is_dir():
        return None
    if plan_name:
        candidate = plans_root / plan_name
        if (candidate / "state.json").is_file():
            return candidate
    dirs = sorted(plans_root.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for d in dirs:
        if (d / "state.json").is_file():
            return d
    return None

plan_dir = _find_plan_dir()
if plan_dir is None:
    # No plan at all yet: a chain that has never born a plan for its first
    # milestone is parked (needs a DRIVE) unless the chain is fully
    # terminal. Fall through to the chain-record check below.
    plan_dir = None
state: dict = {}
if plan_dir is not None:
    try:
        state = json.loads((plan_dir / "state.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
current = state.get("current_state")
if current not in {
    "initialized", "planned", "finalized", "critiqued", "gated",
    "blocked", "failed",
}:
    # The newest plan is terminal (done/executed/reviewed) or absent. A chain
    # that still has PENDING milestones (current_milestone_index < the total
    # milestone sequence) is parked BETWEEN milestones - the next plan is
    # unborn and nothing will drive it unless the fixer picks it up. Read the
    # chain record from the remote spec's .chains dir; if the chain has
    # pending milestones and no current plan, treat it as parked (a DRIVE).
    chain_pending = False
    if remote_spec_raw:
        spec_path = Path(remote_spec_raw)
        if not spec_path.is_absolute():
            spec_path = workspace / spec_path
        chain_dir = workspace / ".megaplan" / "plans" / ".chains"
        import hashlib
        chain_digest = hashlib.sha1(str(spec_path.resolve()).encode("utf-8")).hexdigest()[:12]
        for candidate in (
            chain_dir / f"chain-{chain_digest}.json",
            chain_dir / f"{spec_path.stem}-{chain_digest}.json",
        ):
            if not candidate.is_file():
                continue
            try:
                chain = json.loads(candidate.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            idx = chain.get("current_milestone_index")
            completed = chain.get("completed") or []
            last_state = str(chain.get("last_state") or "")
            # A chain parked at a HUMAN GATE (awaiting_human_verify /
            # awaiting_human) must NOT be driven - the fixer would re-run the
            # same milestone, re-emit the same product-safety user_actions,
            # and park again (grok consult 2026-08-17: the between-milestones
            # drive in a85e968a88 was the mechanical generator of the mega m3
            # U1/U2 loop). Human gates are resolved by a human, not a drive.
            if last_state in {"awaiting_human", "awaiting_human_verify"}:
                chain_pending = False
            else:
                total = 0
                try:
                    spec_text = spec_path.read_text(encoding="utf-8")
                    # chain.yaml is YAML: count top-level "- label:" milestone entries.
                    total = sum(1 for line in spec_text.splitlines() if line.startswith("- label:"))
                except Exception:
                    total = 0
                if isinstance(idx, int) and idx >= 0 and (total == 0 or idx < total):
                    chain_pending = True
                elif completed and (total == 0 or len(completed) < total):
                    chain_pending = True
            break
    if not chain_pending:
        sys.exit(1)
active = state.get("active_step")
if active and isinstance(active, dict) and _pid_alive(active.get("worker_pid")):
    sys.exit(1)  # a worker is live; not parked
# No active step in a stoppage state (or between milestones with no plan):
# parked unless a driver is live.
sys.exit(0)
PY
}

