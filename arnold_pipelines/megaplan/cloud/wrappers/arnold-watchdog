emit_watchdog_incident_bridge_event() {
  local event_kind="$1"
  local session="$2"
  local workspace="$3"
  local remote_spec="$4"
  local summary="$5"
  local status="$6"
  local repair_actor="${7:-immediate_repair}"
  local extra_evidence_json="${8:-[]}"
  PYTHONPATH="${WRAPPER_REPO_ROOT}:${SRC_DIR:-$PWD}:${PYTHONPATH:-}" python3 - \
    "$event_kind" "$session" "$workspace" "$remote_spec" "$summary" "$status" "$repair_actor" \
    "${REPAIR_DATA_DIR:-$MARKER_DIR/repair-data}" "$extra_evidence_json" <<'PY' \
    >> "${LOG:-/dev/null}" 2>&1 || authority_gap_continue "T29-BYPASS-159" "authority-risk bypass converted to typed evidence gap"
import json
import pathlib
import sys

from arnold_pipelines.megaplan.cloud.incident_bridge import (
    append_watchdog_detection,
    append_watchdog_dispatch,
)

(
    event_kind,
    session,
    workspace_raw,
    remote_spec,
    summary,
    status,
    repair_actor,
    repair_data_dir_raw,
    extra_evidence_json,
) = sys.argv[1:]
repair_data_dir = pathlib.Path(repair_data_dir_raw)
data_path = repair_data_dir / f"{session}.repair-data.json"
if not data_path.exists():
    raise SystemExit(0)
try:
    payload = json.loads(data_path.read_text(encoding="utf-8"))
except Exception:
    payload = {}
if not isinstance(payload, dict):
    raise SystemExit(0)
incident_id = str(payload.get("incident_id") or "").strip()
if not incident_id:
    raise SystemExit(0)
problem_id = str(payload.get("problem_id") or "").strip() or None
workspace = pathlib.Path(workspace_raw) if workspace_raw else pathlib.Path.cwd()
evidence = [
    {
        "kind": "watchdog_observation",
        "status": status,
        "repair_actor": repair_actor,
        "workspace": workspace_raw,
        "remote_spec": remote_spec,
    }
]
try:
    loaded_extra = json.loads(extra_evidence_json)
except Exception:
    loaded_extra = []
if isinstance(loaded_extra, list):
    evidence.extend(loaded_extra)
elif isinstance(loaded_extra, dict):
    evidence.append(loaded_extra)

if event_kind == "detection":
    append_watchdog_detection(
        incident_id=incident_id,
        summary=summary,
        outcome=status,
        evidence=evidence,
        session_id=session,
        problem_id=problem_id,
        next_expected_event="watchdog.dispatch",
        root=workspace,
    )
    raise SystemExit(0)

next_expected_event = None
if status == "dispatched":
    if repair_actor == "meta_repair":
        next_expected_event = "meta_repair.repair_attempt"
    else:
        next_expected_event = "immediate_repair.repair_attempt"
append_watchdog_dispatch(
    incident_id=incident_id,
    summary=summary,
    outcome=status,
    evidence=evidence,
    session_id=session,
    problem_id=problem_id,
    next_expected_event=next_expected_event,
    decision={
        "repair_actor": repair_actor,
